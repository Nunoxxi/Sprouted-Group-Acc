generator client {
  provider = "prisma-client-js"
}

// Postgres. DATABASE_URL is the transaction pooler (runtime); DIRECT_URL is the
// session pooler, used only by `prisma migrate`. See .env.example.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Money is stored as BigInt pesewas. Postgres's Int is 32-bit and would cap a
// single line at GHS 21.4M; SQLite's was 64-bit. Every read converts to a JS
// number through src/lib/data/money.ts — generated bigint types never leave
// src/lib/data.
// ---------------------------------------------------------------------------

enum Currency {
  GHS
  USD
  EUR
}

// Entity.id is the slug the UI uses ('sprouted-roots'); code is the statutory
// short code ('SG001'). One identifier everywhere, no alias tables.
model Entity {
  id                      String              @id
  code                    String              @unique
  name                    String
  type                    String // 'programs' | 'manufacturing'
  financialYearEnd        String?
  /// VAT registration is per entity, off by default. VAT is calculated only
  /// for this entity and only on documents dated on or after vatRegisteredFrom.
  vatRegistered           Boolean             @default(false)
  vatRegisteredFrom       DateTime?           @db.Date
  tin                     String?
  /// Sender for invitations and password resets to this entity's people, e.g.
  /// "Sprouted Crafts <crafts@sproutedgroup.com>". Null falls back to EMAIL_FROM.
  emailFrom               String?
  accent                  String?
  /// The currency the books are kept and reported in. Per entity, never global.
  functionalCurrency      Currency            @default(GHS)
  /// A buying agent's open float older than this is flagged on the dashboard.
  floatAgeLimitDays       Int                 @default(14)
  /// Operating as a COCOBOD Licensed Buying Company: seed funds are a
  /// liability, purchases are at the gazetted producer price, deliveries go
  /// to CMC take-over centres, margin and haulage are separate income.
  lbcMode                 Boolean             @default(false)
  /// Gross (producer value as sales, cost as COGS) or net (margin and
  /// haulage only): the principal-versus-agent judgement, made by a person.
  revenuePresentation     RevenuePresentation @default(GROSS)
  /// Gazetted rates, minor units per kg, set by hand when COCOBOD publishes them.
  producerPriceMinorPerKg BigInt?
  buyerMarginMinorPerKg   BigInt?
  haulageMinorPerKg       BigInt?
  /// Whether this entity pays company tax at all, and if so at whose rate.
  /// Sprouted Roots may be exempt; the computation is hidden when it is.
  taxStatus               EntityTaxStatus     @default(TAXABLE)
  /// Opening balances are dated here; imports are allowed until liveAt is set.
  cutOverDate             DateTime?           @db.Date
  liveAt                  DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  userAccess          UserEntityAccess[]
  exchangeRates       ExchangeRate[]
  bankAccounts        BankAccount[]
  payments            Payment[]
  revaluations        Revaluation[]
  accounts            Account[]
  journalEntries      JournalEntry[]
  contactBalances     ContactEntityBalance[]
  auditEvents         AuditEvent[]
  funds               Fund[]
  projects            Project[]
  documents           Document[]
  documentLines       DocumentLine[]
  taxPeriodFilings    TaxPeriodFiling[]
  documentCounters    DocumentCounter[]
  backupRuns          BackupRun[]
  items               Item[]
  stockLocations      StockLocation[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  stockCounts         StockCount[]
  stockCountLines     StockCountLine[]
  nrvPrices           NrvPrice[]
  commodities         Commodity[]
  lots                Lot[]
  landedCosts         LandedCostAllocation[]
  buyingAgents        BuyingAgent[]
  floatAdvances       FloatAdvance[]
  floatReturns        FloatReturn[]
  agentPurchases      AgentPurchase[]
  salesContracts      SalesContract[]
  deliveries          ContractDelivery[]
  sellingCosts        ContractSellingCost[]
  seedFunds           SeedFundMovement[]
  openingBatches      OpeningBatch[]
  farmerAdvances      FarmerAdvance[]
  farmers             Farmer[]
  statementMappings   StatementMapping[]
  statementImports    StatementImport[]
  statementLines      StatementLine[]
  paymentBatches      FarmerPaymentBatch[]
  farmerPayments      FarmerPayment[]
  grants              Grant[]
  grantBudgetLines    GrantBudgetLine[]
  grantConditions     GrantCondition[]
  grantReceipts       GrantReceipt[]
  grantReleases       GrantRelease[]
  inKind              InKindContribution[]
  staffTime           StaffTimeAllocation[]
  buyingSeasons       BuyingSeason[]
  recurringCosts      RecurringCost[]
  cashScenarios       CashScenario[]
  cashScenarioRates   CashScenarioRate[]
  cashScenarioLines   CashScenarioLine[]
  fixedAssets         FixedAsset[]
  depreciationRuns    DepreciationRun[]
  assetDisposals      AssetDisposal[]
  allowanceClasses    CapitalAllowanceClass[]
  taxYears            TaxYear[]
  taxAdjustments      TaxAdjustment[]
  provisionalTax      ProvisionalTaxPayment[]
  attachments         Attachment[]
  attachmentRules     AttachmentRule[]
  dataRequests        DataSubjectRequest[]
  projectBudgetLines  ProjectBudgetLine[]
  assetCategories     AssetCategory[]
  taxRateSetting      TaxRateSetting?
  preFinanceSetting   PreFinanceSetting?
  loanFacilities      LoanFacility[]
  loanTranches        LoanTranche[]
  aggregatorAdvances  AggregatorAdvance[]
  advanceDeliveries   AdvanceDelivery[]
  preFinanceCycles    PreFinanceCycle[]
  payrollSetting      PayrollSetting?
  employees           Employee[]
  employeeAllowances  EmployeeAllowance[]
  employeeAllocations EmployeeAllocation[]
  staffLoans          StaffLoan[]
  payRuns             PayRun[]
  payRunLines         PayRunLine[]
  payRunDeductions    PayRunDeduction[]
  payrollRemittances  PayrollRemittance[]
  floatLabour         FloatLabourPayment[]
}

// Append-only. Events form a hash chain per entity ordered by `sequence`, which
// is allocated under an advisory lock so concurrent writers cannot fork the
// chain. metadataJson is deliberately text, not jsonb: jsonb reorders keys and
// the stored bytes must be exactly the bytes that were hashed.
model AuditEvent {
  id           String   @id @default(cuid())
  entityId     String
  sequence     Int
  /// NULL only for system events (scheduled exports). Part of the hashed record.
  userId       String?
  userName     String
  action       String // POST | EDIT | VOID | MATCH | BACKUP | FILE_PERIOD | USER | VIEW_PII | ERASE
  resourceType String // invoice | bill | bank-line | intercompany | vat-period | backup
  resourceRef  String
  summary      String
  metadataJson String?
  hash         String
  previousHash String?
  createdAt    DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@unique([entityId, sequence])
  @@index([entityId, resourceType])
  @@index([userId])
}

// One row per ledger export (formerly per SQLite snapshot). Rows are never
// deleted; only the files are pruned past the retention limit.
model BackupRun {
  id        String   @id @default(cuid())
  entityId  String?
  kind      String   @default("export")
  fileName  String
  filePath  String
  sizeBytes Int
  status    String // SUCCESS | FAILED
  error     String?
  checksum  String
  createdAt DateTime @default(now())

  entity Entity? @relation(fields: [entityId], references: [id])

  @@index([entityId, createdAt])
  @@index([createdAt])
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum ContactCategory {
  CUSTOMER
  SUPPLIER
  FARMER
  GROUP_ENTITY
  OTHER
}

enum WithholdingTaxStatus {
  NONE
  WHT_5
  WHT_10
  EXEMPT
}

// Contacts are shared across the group — the same supplier trades with all
// three entities. Entity scoping happens on ContactEntityBalance and Document.
model Contact {
  lots           Lot[]
  salesContracts SalesContract[]

  id                   String               @id @default(cuid())
  name                 String
  type                 ContactType
  category             ContactCategory      @default(OTHER)
  tin                  String?
  phone                String?
  email                String?
  address              String?
  withholdingTaxStatus WithholdingTaxStatus @default(NONE)
  /// Most this contact may owe at once as un-delivered pre-finance advances.
  /// Null means no limit has been set; nil means no further advances.
  exposureLimitMinor   BigInt?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  balances            ContactEntityBalance[]
  documents           Document[]
  journalLines        JournalLine[]
  grants              Grant[]
  inKindContributions InKindContribution[]
  fixedAssets         FixedAsset[]
  projects            Project[]
  facilitiesLent      LoanFacility[]         @relation("FacilityLender")
  advancesReceived    AggregatorAdvance[]    @relation("AdvanceAggregator")
}

model ContactEntityBalance {
  id           String   @id @default(cuid())
  contactId    String
  entityId     String
  balanceMinor BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id])
  entity  Entity  @relation(fields: [entityId], references: [id])

  @@unique([contactId, entityId])
  @@index([entityId, balanceMinor])
}

// ---------------------------------------------------------------------------
// Users and authentication. Better Auth owns User, AuthSession, AuthAccount,
// AuthVerification, TwoFactor and RateLimit (see src/lib/auth.ts); the app
// never writes password hashes, sessions or tokens itself. Users are never
// deleted — deactivatedAt is set and every session revoked — so the user id
// on every journal, document, filing and audit event keeps resolving.
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  /// owner | accountant | bookkeeper | data-entry | viewer — see src/lib/authz.ts
  role                String    @default("viewer")
  /// Better Auth admin plugin. A "ban" is how the library refuses sign-in;
  /// banReason distinguishes LOCKED (ten failed attempts) from DEACTIVATED.
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime?
  twoFactorEnabled    Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  deactivatedAt       DateTime?
  invitedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  invitedBy              User?                   @relation("Invitations", fields: [invitedById], references: [id])
  invitees               User[]                  @relation("Invitations")
  sessions               AuthSession[]
  authAccounts           AuthAccount[]
  twoFactors             TwoFactor[]
  entityAccess           UserEntityAccess[]
  grantedAccess          UserEntityAccess[]      @relation("AccessGrantedBy")
  auditEvents            AuditEvent[]
  postedEntries          JournalEntry[]
  createdDocs            Document[]              @relation("DocumentCreatedBy")
  editedDocs             Document[]              @relation("DocumentEditedBy")
  filings                TaxPeriodFiling[]
  exchangeRates          ExchangeRate[]
  payments               Payment[]
  revaluations           Revaluation[]           @relation("RevaluationRunBy")
  reversedRevaluations   Revaluation[]           @relation("RevaluationReversedBy")
  stockMovements         StockMovement[]
  stockCounts            StockCount[]            @relation("StockCountCreatedBy")
  postedStockCounts      StockCount[]            @relation("StockCountPostedBy")
  nrvPrices              NrvPrice[]
  lots                   Lot[]
  floatAdvances          FloatAdvance[]          @relation("FloatCreatedBy")
  reconciledFloats       FloatAdvance[]          @relation("FloatReconciledBy")
  floatReturns           FloatReturn[]
  agentPurchases         AgentPurchase[]         @relation("PurchaseCreatedBy")
  postedPurchases        AgentPurchase[]         @relation("PurchasePostedBy")
  salesContracts         SalesContract[]
  deliveries             ContractDelivery[]      @relation("DeliveryCreatedBy")
  acceptedDeliveries     ContractDelivery[]      @relation("DeliveryAcceptedBy")
  seedFunds              SeedFundMovement[]
  openingBatches         OpeningBatch[]
  farmerAdvances         FarmerAdvance[]
  statementImports       StatementImport[]
  paymentBatches         FarmerPaymentBatch[]    @relation("BatchCreatedBy")
  paidBatches            FarmerPaymentBatch[]    @relation("BatchPaidBy")
  grants                 Grant[]
  grantConditions        GrantCondition[]
  grantReceipts          GrantReceipt[]
  grantReleases          GrantRelease[]
  inKindContributions    InKindContribution[]
  staffTimeAllocations   StaffTimeAllocation[]
  buyingSeasons          BuyingSeason[]
  recurringCosts         RecurringCost[]
  cashScenarios          CashScenario[]
  cashScenarioLines      CashScenarioLine[]
  fixedAssets            FixedAsset[]
  depreciationRuns       DepreciationRun[]
  assetDisposals         AssetDisposal[]
  taxYears               TaxYear[]
  provisionalTaxPayments ProvisionalTaxPayment[]
  attachments            Attachment[]
  dataSubjectRequests    DataSubjectRequest[]
  preFinanceSettings     PreFinanceSetting[]     @relation("PreFinanceSettingUpdatedBy")
  loanFacilities         LoanFacility[]          @relation("FacilityCreatedBy")
  loanTranches           LoanTranche[]           @relation("TrancheCreatedBy")
  aggregatorAdvances     AggregatorAdvance[]     @relation("AdvanceCreatedBy")
  advanceDeliveries      AdvanceDelivery[]       @relation("DeliveryCreatedBy")
  preFinanceCycles       PreFinanceCycle[]       @relation("CycleCreatedBy")

  @@index([deactivatedAt])
}

// Entity access is separate from role: an Accountant on Sprouted Roots with
// no row for Oikazi cannot see Oikazi at all. Owners have every entity
// implicitly (src/lib/authz.ts) and hold no rows here.
model UserEntityAccess {
  userId      String
  entityId    String
  grantedById String?
  createdAt   DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id])
  entity    Entity @relation(fields: [entityId], references: [id])
  grantedBy User?  @relation("AccessGrantedBy", fields: [grantedById], references: [id])

  @@id([userId, entityId])
  @@index([entityId])
}

model AuthSession {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  COST_OF_SALES
  EXPENSE
}

model Account {
  id        String      @id @default(cuid())
  entityId  String
  parentId  String?
  code      String
  name      String
  type      AccountType
  category  String?
  isActive  Boolean     @default(true)
  /// Where it sits in the chart. Equal values fall back to the code, so an
  /// unordered chart still reads in account-number order.
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  entity               Entity                @relation(fields: [entityId], references: [id])
  parent               Account?              @relation("AccountParent", fields: [parentId], references: [id])
  children             Account[]             @relation("AccountParent")
  journalLines         JournalLine[]
  documentLines        DocumentLine[]
  bankAccount          BankAccount?
  items                Item[]
  stockLocations       StockLocation[]
  grantBudgetLines     GrantBudgetLine[]
  staffTimeAllocations StaffTimeAllocation[]
  recurringCosts       RecurringCost[]
  projectBudgetLines   ProjectBudgetLine[]
  assetCategories      AssetCategory[]
  employees            Employee[]
  floatLabour          FloatLabourPayment[]

  @@unique([entityId, code])
  @@index([entityId, parentId])
  @@index([entityId, type])
}

enum JournalKind {
  DOCUMENT
  REVERSAL
  MANUAL
  PAYMENT
  REVALUATION
  STOCK
  CONTRACT
  OPENING
}

// postedAt is the accounting date (a document's own date), never "now" —
// reports and period locks must agree with the document.
model JournalEntry {
  id           String      @id @default(cuid())
  entityId     String
  kind         JournalKind @default(MANUAL)
  reference    String?
  description  String
  postedAt     DateTime
  reversalOfId String?     @unique
  /// Who posted it. NULL only for entries that predate authentication.
  postedById   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  entity                Entity                 @relation(fields: [entityId], references: [id])
  postedBy              User?                  @relation(fields: [postedById], references: [id])
  lines                 JournalLine[]
  reversalOf            JournalEntry?          @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy            JournalEntry?          @relation("Reversal")
  postedDocument        Document?              @relation("DocumentPosting")
  voidedDocument        Document?              @relation("DocumentVoid")
  payment               Payment?
  revaluation           Revaluation?           @relation("RevaluationEntry")
  revaluationReversal   Revaluation?           @relation("RevaluationReversal")
  stockMovements        StockMovement[]
  stockCount            StockCount?
  floatAdvance          FloatAdvance?
  floatReturn           FloatReturn?
  agentPurchase         AgentPurchase?
  delivery              ContractDelivery?      @relation("DeliveryJournal")
  acceptance            ContractDelivery?      @relation("AcceptanceJournal")
  seedFund              SeedFundMovement?
  openingBatch          OpeningBatch?
  farmerAdvance         FarmerAdvance?
  paymentBatch          FarmerPaymentBatch?    @relation("BatchJournal")
  batchSettlement       FarmerPaymentBatch?    @relation("BatchSettlementJournal")
  statementLines        StatementLine[]
  grantReceipt          GrantReceipt?
  grantRelease          GrantRelease?
  inKindContribution    InKindContribution?
  staffTimeAllocation   StaffTimeAllocation?
  depreciationRun       DepreciationRun?
  assetDisposal         AssetDisposal?
  taxYear               TaxYear?
  provisionalTaxPayment ProvisionalTaxPayment?
  loanTranche           LoanTranche?
  aggregatorAdvance     AggregatorAdvance?
  advanceDelivery       AdvanceDelivery?
  payRunPosting         PayRun?                @relation("PayRunJournal")
  payRunReversal        PayRun?                @relation("PayRunReversal")
  staffLoan             StaffLoan?
  payrollRemittance     PayrollRemittance?
  floatLabour           FloatLabourPayment?

  @@index([entityId, postedAt])
  @@index([entityId, kind])
}

model JournalLine {
  id             String           @id @default(cuid())
  entityId       String
  journalEntryId String
  accountId      String
  fundId         String?
  projectId      String?
  contactId      String?
  /// Grant analysis. Expenditure charged to a grant always names a budget
  /// line too, so budget-against-actual reads straight off the ledger.
  grantId        String?
  budgetLineId   String?
  /// Transaction currency and amount, the rate applied, and — in amountMinor —
  /// the functional amount that resulted. amountMinor is fixed at posting and
  /// never recomputed from the rate: a historic rate is history.
  txnCurrency    Currency         @default(GHS)
  txnAmountMinor BigInt           @default(0)
  rate           Decimal          @default(1) @db.Decimal(20, 10)
  amountMinor    BigInt
  direction      JournalDirection
  createdAt      DateTime         @default(now())

  journalEntry JournalEntry     @relation(fields: [journalEntryId], references: [id])
  account      Account          @relation(fields: [accountId], references: [id])
  fund         Fund?            @relation(fields: [fundId], references: [id])
  project      Project?         @relation(fields: [projectId], references: [id])
  contact      Contact?         @relation(fields: [contactId], references: [id])
  grant        Grant?           @relation(fields: [grantId], references: [id])
  budgetLine   GrantBudgetLine? @relation(fields: [budgetLineId], references: [id])

  @@index([entityId, grantId])
  @@index([entityId, journalEntryId])
  @@index([entityId, accountId])
  @@index([entityId, fundId])
  @@index([entityId, projectId])
  @@index([entityId, contactId])
}

enum FundClassification {
  RESTRICTED
  UNRESTRICTED
}

model Fund {
  id             String             @id @default(cuid())
  entityId       String
  code           String
  name           String
  classification FundClassification
  funder         String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  entity        Entity         @relation(fields: [entityId], references: [id])
  journalLines  JournalLine[]
  projects      Project[]
  documentLines DocumentLine[]
  grants        Grant[]

  @@unique([entityId, code])
  @@index([entityId, classification])
}

/// Grant funded, or paid for under a contract for services.
enum ProjectKind {
  GRANT_FUNDED
  SERVICE_CONTRACT
}

model Project {
  id              String      @id @default(cuid())
  entityId        String
  fundId          String?
  code            String
  name            String
  /// Kept as free text as well as a contact, because older projects named a
  /// funder before funders were contacts.
  funder          String?
  funderContactId String?
  kind            ProjectKind @default(GRANT_FUNDED)
  /// What was awarded, in the funder's own currency.
  currency        Currency    @default(GHS)
  fundingMinor    BigInt      @default(0)
  startDate       DateTime?   @db.Date
  endDate         DateTime?   @db.Date
  /// Set when the project is closed. It then leaves the coding lists but stays
  /// in every report, and an Owner can reopen it.
  closedAt        DateTime?
  budgetMinor     BigInt      @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  entity              Entity               @relation(fields: [entityId], references: [id])
  fund                Fund?                @relation(fields: [fundId], references: [id])
  funderContact       Contact?             @relation(fields: [funderContactId], references: [id])
  budgetLines         ProjectBudgetLine[]
  journalLines        JournalLine[]
  documentLines       DocumentLine[]
  grants              Grant[]
  employeeAllocations EmployeeAllocation[]

  @@unique([entityId, code])
  @@index([entityId, fundId])
}

enum JournalDirection {
  MONEY_IN
  MONEY_OUT
}

// ---------------------------------------------------------------------------
// Documents: invoices and bills. A document is posted by creating a balanced
// JournalEntry (journalEntryId) and voided by creating a reversing one
// (voidEntryId). Nothing is ever deleted.
// ---------------------------------------------------------------------------

enum DocumentKind {
  INVOICE
  BILL
}

enum DocumentStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  VOIDED
}

enum VatTreatment {
  STANDARD
  ZERO_RATED
  EXEMPT
}

/// Invoices only. Exports are zero-rated once the entity is VAT registered;
/// the flag exists now so sales are classified before that day.
enum SaleType {
  DOMESTIC
  EXPORT
}

model Document {
  id                  String         @id @default(cuid())
  entityId            String
  kind                DocumentKind
  /// Allocated on posting. NULL while a draft: the (entityId, number) unique
  /// index must not stop an entity holding more than one draft at a time.
  number              String?
  contactId           String
  date                DateTime
  dueDate             DateTime
  status              DocumentStatus @default(DRAFT)
  /// Transaction currency of every line; unit prices are in its minor units.
  currency            Currency       @default(GHS)
  /// The rate fixed at posting (functional per 1 unit of currency). Editable while a draft.
  rate                Decimal?       @db.Decimal(20, 10)
  rateDate            DateTime?
  /// False when the rate came from an earlier date than the document, or was overridden.
  rateExact           Boolean        @default(true)
  /// Settled so far, in the document currency.
  paidTxnMinor        BigInt         @default(0)
  saleType            SaleType       @default(DOMESTIC)
  /// Bills only: VAT paid at the point of entry on an import, document currency.
  importVatMinor      BigInt         @default(0)
  /// Whether VAT was calculated on this document — fixed at posting from the
  /// entity's registration and the document date, so a later registration
  /// never changes how a posted document reads.
  vatApplied          Boolean        @default(false)
  evatClearanceNumber String?
  evatQrCode          String?
  evatTimestamp       String?
  journalEntryId      String?        @unique
  voidEntryId         String?        @unique
  createdById         String?
  lastEditedById      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  entity       Entity         @relation(fields: [entityId], references: [id])
  contact      Contact        @relation(fields: [contactId], references: [id])
  createdBy    User?          @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  lastEditedBy User?          @relation("DocumentEditedBy", fields: [lastEditedById], references: [id])
  journalEntry JournalEntry?  @relation("DocumentPosting", fields: [journalEntryId], references: [id])
  voidEntry    JournalEntry?  @relation("DocumentVoid", fields: [voidEntryId], references: [id])
  lines        DocumentLine[]
  payments     Payment[]

  @@unique([entityId, number])
  @@index([entityId, status])
  @@index([entityId, date])
  @@index([entityId, contactId])
}

model DocumentLine {
  id              String           @id @default(cuid())
  documentId      String
  entityId        String
  position        Int
  description     String
  quantity        Float // not money: 1.5 kg is a legitimate quantity
  unitPriceMinor  BigInt
  accountId       String
  vatTreatment    VatTreatment     @default(STANDARD)
  projectId       String?
  fundId          String?
  /// Bills only: the stock item this line receives, and where. Set when the
  /// line's account is an inventory account; posting the bill creates the
  /// receipt. `quantity` is then in the item's base unit.
  itemId          String?
  locationId      String?
  /// A charge capitalised into stock (transport, bags, ...), spread per kg over the lots it relates to.
  landedCostKind  LandedCostKind?
  /// Origin and quality of the lot a stock line receives; all optional.
  lotRef          String?
  community       String?
  district        String?
  qualityJson     String?
  /// A directly attributable selling cost of a sales contract (transport to
  /// buyer or port, permits, levies): posted to the expense account chosen,
  /// attributed to the contract for its margin.
  contractId      String?
  sellingCostKind SellingCostKind?
  /// Expenditure charged to a grant. Both or neither: a grant always names
  /// the budget line the money comes out of.
  grantId         String?
  budgetLineId    String?

  document       Document               @relation(fields: [documentId], references: [id])
  entity         Entity                 @relation(fields: [entityId], references: [id])
  account        Account                @relation(fields: [accountId], references: [id])
  project        Project?               @relation(fields: [projectId], references: [id])
  fund           Fund?                  @relation(fields: [fundId], references: [id])
  item           Item?                  @relation(fields: [itemId], references: [id])
  location       StockLocation?         @relation(fields: [locationId], references: [id])
  receipts       StockMovement[]
  lot            Lot?
  landedCostLots LandedCostAllocation[]
  contract       SalesContract?         @relation(fields: [contractId], references: [id])
  sellingCost    ContractSellingCost?
  grant          Grant?                 @relation(fields: [grantId], references: [id])
  budgetLine     GrantBudgetLine?       @relation(fields: [budgetLineId], references: [id])

  @@index([documentId, position])
  @@index([entityId, accountId])
}

// Filing a VAT period locks it: documents dated in a filed period cannot be
// posted, and a void's reversal must land in an open period.
model TaxPeriodFiling {
  id        String   @id @default(cuid())
  entityId  String
  period    String // YYYY-MM
  filedAt   DateTime @default(now())
  filedBy   String
  filedById String?

  entity      Entity @relation(fields: [entityId], references: [id])
  filedByUser User?  @relation(fields: [filedById], references: [id])

  @@unique([entityId, period])
}

// Server-side document numbering, allocated inside the posting transaction so
// two clients cannot claim the same number.
model DocumentCounter {
  entityId String
  kind     DocumentKind
  next     Int          @default(1)

  entity Entity @relation(fields: [entityId], references: [id])

  @@id([entityId, kind])
}

// ---------------------------------------------------------------------------
// Multi-currency. Rates are per entity (actual bank rates differ), per pair,
// per date; a transaction defaults to its date's rate or the latest prior
// one and may be overridden. Bank accounts hold one currency and are never
// stored converted. Payments carry the realised FX difference; Revaluations
// carry the unrealised one and can be reversed into the next period.
// ---------------------------------------------------------------------------

model ExchangeRate {
  id          String   @id @default(cuid())
  entityId    String
  base        Currency
  quote       Currency
  date        DateTime @db.Date
  /// Units of quote per 1 unit of base, exact to 10 decimal places.
  rate        Decimal  @db.Decimal(20, 10)
  source      String?
  createdById String?
  createdAt   DateTime @default(now())

  entity    Entity @relation(fields: [entityId], references: [id])
  createdBy User?  @relation(fields: [createdById], references: [id])

  @@unique([entityId, base, quote, date])
  @@index([entityId, date])
}

model BankAccount {
  floatAdvances FloatAdvance[]
  floatReturns  FloatReturn[]
  seedFunds     SeedFundMovement[]

  id        String          @id @default(cuid())
  entityId  String
  name      String
  currency  Currency
  /// A mobile money wallet is a bank account with a provider and a number;
  /// it reconciles the same way and has its own GL account.
  kind      BankAccountKind @default(BANK)
  provider  String?
  number    String?
  /// The GL account this bank posts to; one per bank account.
  accountId String          @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  entity                 Entity                  @relation(fields: [entityId], references: [id])
  account                Account                 @relation(fields: [accountId], references: [id])
  payments               Payment[]
  statementImports       StatementImport[]
  statementLines         StatementLine[]
  paymentBatches         FarmerPaymentBatch[]
  grantReceipts          GrantReceipt[]
  assetDisposals         AssetDisposal[]
  provisionalTaxPayments ProvisionalTaxPayment[]
  loanTranches           LoanTranche[]
  aggregatorAdvances     AggregatorAdvance[]
  staffLoans             StaffLoan[]
  payrollRemittances     PayrollRemittance[]

  @@index([entityId])
}

model Payment {
  id                  String   @id @default(cuid())
  entityId            String
  documentId          String
  bankAccountId       String
  date                DateTime
  /// Settled amount in the document's currency.
  txnAmountMinor      BigInt
  /// Settlement rate: functional per 1 unit of document currency.
  rate                Decimal  @db.Decimal(20, 10)
  /// What hit the bank, in the bank's currency.
  bankAmountMinor     BigInt
  bankFunctionalMinor BigInt
  /// Functional value of the receivable/payable cleared, at the document's rate.
  reliefMinor         BigInt
  /// Positive = realised gain, negative = loss, functional currency.
  gainLossMinor       BigInt
  journalEntryId      String   @unique
  recordedById        String?
  createdAt           DateTime @default(now())

  entity       Entity       @relation(fields: [entityId], references: [id])
  document     Document     @relation(fields: [documentId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  recordedBy   User?        @relation(fields: [recordedById], references: [id])

  @@index([entityId, documentId])
  @@index([entityId, date])
}

model Revaluation {
  id               String    @id @default(cuid())
  entityId         String
  period           String // YYYY-MM
  /// The closing rates used, as entered: {"USD":"12.8","EUR":"14.1"}.
  closingRatesJson String
  journalEntryId   String    @unique
  reversalEntryId  String?   @unique
  runById          String?
  reversedById     String?
  createdAt        DateTime  @default(now())
  reversedAt       DateTime?

  entity        Entity        @relation(fields: [entityId], references: [id])
  journalEntry  JournalEntry  @relation("RevaluationEntry", fields: [journalEntryId], references: [id])
  reversalEntry JournalEntry? @relation("RevaluationReversal", fields: [reversalEntryId], references: [id])
  runBy         User?         @relation("RevaluationRunBy", fields: [runById], references: [id])
  reversedBy    User?         @relation("RevaluationReversedBy", fields: [reversedById], references: [id])

  @@unique([entityId, period])
}

// --- inventory ----------------------------------------------------------------------
//
// Quantities are integer grams, the way money is integer pesewas: no float
// ever touches a weight. Bags, cartons and tonnes are display conversions
// per item. Value is the entity's functional currency, fixed at receipt.
// Cost is carried as value / quantity (weighted average), never as a stored
// unit price that could drift from the ledger.

enum ItemCategory {
  RAW_MATERIAL
  PACKAGING
  WORK_IN_PROGRESS
  FINISHED_GOOD
  BY_PRODUCT
}

enum StockUnit {
  KG
  BAG
  CARTON
  TONNE
}

enum StockMovementKind {
  RECEIPT
  RECEIPT_REVERSAL
  TRANSFER
  ADJUSTMENT
  WRITE_DOWN
  LANDED_COST
  SHRINKAGE
  DELIVERY
}

enum AdjustmentReason {
  COUNT_DIFFERENCE
  MOISTURE_LOSS
  DAMAGE
  SPOILAGE
  NRV_WRITE_DOWN
  ABNORMAL_LOSS
}

enum StockCountStatus {
  DRAFT
  POSTED
}

model Item {
  id             String       @id @default(cuid())
  entityId       String
  code           String
  name           String
  category       ItemCategory
  /// The unit the item is bought and counted in. Storage is always grams.
  baseUnit       StockUnit    @default(KG)
  gramsPerBag    Int?
  gramsPerCarton Int?
  /// The inventory GL account this item's stock is carried in.
  accountId      String
  /// A trading item is one grade of a commodity; costing runs per item per location.
  commodityId    String?
  grade          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  entity         Entity           @relation(fields: [entityId], references: [id])
  account        Account          @relation(fields: [accountId], references: [id])
  balances       StockBalance[]
  movements      StockMovement[]
  countLines     StockCountLine[]
  nrvPrices      NrvPrice[]
  documentLines  DocumentLine[]
  commodity      Commodity?       @relation(fields: [commodityId], references: [id])
  lots           Lot[]
  agentPurchases AgentPurchase[]
  salesContracts SalesContract[]

  @@unique([entityId, code])
  @@index([entityId, category])
}

model StockLocation {
  id        String   @id @default(cuid())
  entityId  String
  code      String
  name      String
  /// Optional: stock held here is carried in this account instead of the
  /// item's (e.g. Goods in Transit). A transfer into or out of such a
  /// location posts between the two accounts.
  accountId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  entity         Entity             @relation(fields: [entityId], references: [id])
  account        Account?           @relation(fields: [accountId], references: [id])
  balances       StockBalance[]
  movementsFrom  StockMovement[]    @relation("MovementFrom")
  movementsTo    StockMovement[]    @relation("MovementTo")
  counts         StockCount[]
  documentLines  DocumentLine[]
  lots           Lot[]
  agents         BuyingAgent[]
  agentPurchases AgentPurchase[]
  deliveries     ContractDelivery[]

  @@unique([entityId, code])
}

/// Quantity and value on hand per item per location. Value / quantity across
/// an item's locations is its weighted average cost.
model StockBalance {
  id            String   @id @default(cuid())
  entityId      String
  itemId        String
  locationId    String
  quantityGrams BigInt   @default(0)
  valueMinor    BigInt   @default(0)
  updatedAt     DateTime @updatedAt

  entity   Entity        @relation(fields: [entityId], references: [id])
  item     Item          @relation(fields: [itemId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@unique([itemId, locationId])
  @@index([entityId])
}

/// Append-only. Every change to stock is one of these; nothing edits a
/// balance directly. A receipt's ledger posting is its bill's journal; every
/// other kind carries its own STOCK journal when it has a ledger effect.
model StockMovement {
  id             String            @id @default(cuid())
  entityId       String
  kind           StockMovementKind
  date           DateTime
  itemId         String
  fromLocationId String?
  toLocationId   String?
  /// Signed. Positive adds at toLocation; negative removes at fromLocation; a
  /// transfer is positive and names both.
  quantityGrams  BigInt
  /// Signed, functional currency. A write-down has quantity 0 and negative value.
  valueMinor     BigInt
  reason         AdjustmentReason?
  note           String?
  documentId     String?
  documentLineId String?
  stockCountId   String?
  lotId          String?
  deliveryId     String?
  journalEntryId String?
  reversesId     String?           @unique
  createdById    String?
  createdAt      DateTime          @default(now())

  entity          Entity            @relation(fields: [entityId], references: [id])
  item            Item              @relation(fields: [itemId], references: [id])
  fromLocation    StockLocation?    @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocation      StockLocation?    @relation("MovementTo", fields: [toLocationId], references: [id])
  documentLine    DocumentLine?     @relation(fields: [documentLineId], references: [id])
  stockCount      StockCount?       @relation(fields: [stockCountId], references: [id])
  lot             Lot?              @relation(fields: [lotId], references: [id])
  delivery        ContractDelivery? @relation(fields: [deliveryId], references: [id])
  journalEntry    JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  reverses        StockMovement?    @relation("MovementReversal", fields: [reversesId], references: [id])
  reversedBy      StockMovement?    @relation("MovementReversal")
  createdBy       User?             @relation(fields: [createdById], references: [id])
  advanceDelivery AdvanceDelivery?

  @@index([entityId, date])
  @@index([entityId, itemId])
  @@index([documentId])
}

model StockCount {
  id             String           @id @default(cuid())
  entityId       String
  locationId     String
  date           DateTime
  status         StockCountStatus @default(DRAFT)
  note           String?
  journalEntryId String?          @unique
  createdById    String?
  postedById     String?
  postedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  entity       Entity           @relation(fields: [entityId], references: [id])
  location     StockLocation    @relation(fields: [locationId], references: [id])
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  createdBy    User?            @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  postedBy     User?            @relation("StockCountPostedBy", fields: [postedById], references: [id])
  lines        StockCountLine[]
  movements    StockMovement[]

  @@index([entityId, status])
}

model StockCountLine {
  id            String  @id @default(cuid())
  stockCountId  String
  entityId      String
  itemId        String
  /// Snapshot when the count was saved; recomputed at posting.
  expectedGrams BigInt
  countedGrams  BigInt?

  stockCount StockCount @relation(fields: [stockCountId], references: [id])
  entity     Entity     @relation(fields: [entityId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])

  @@unique([stockCountId, itemId])
}

/// Net realisable value: the selling price per kg entered for an item for a
/// period. The NRV report compares it with weighted average cost.
model NrvPrice {
  id                     String   @id @default(cuid())
  entityId               String
  itemId                 String
  period                 String // YYYY-MM
  sellingPriceMinorPerKg BigInt
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  entity    Entity @relation(fields: [entityId], references: [id])
  item      Item   @relation(fields: [itemId], references: [id])
  createdBy User?  @relation(fields: [createdById], references: [id])

  @@unique([entityId, itemId, period])
}

// --- trading: commodities, lots, landed cost, agents and floats -------------------
//
// Sprouted Crafts trades raw cashew nuts and Oikazi trades cocoa beans;
// neither processes anything. Stock of the same grade is interchangeable,
// so cost is a weighted average per commodity × grade × location (an Item
// is one grade of a commodity; StockBalance already keys on item and
// location). Lots carry origin and quality for traceability and never
// carry cost.

enum CommodityKind {
  CASHEW
  COCOA
  OTHER
}

model Commodity {
  id                    String        @id @default(cuid())
  entityId              String
  code                  String
  name                  String
  kind                  CommodityKind @default(OTHER)
  /// Bought and sold by the bag: grams in one bag of this commodity.
  gramsPerBag           Int
  /// Moisture shrinkage up to this percentage of weight in is normal and stays in
  /// the cost of the remaining stock; beyond it is stock loss expense.
  shrinkageTolerancePct Decimal       @default(2) @db.Decimal(6, 3)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  entity        Entity          @relation(fields: [entityId], references: [id])
  items         Item[]
  lots          Lot[]
  contracts     SalesContract[]
  buyingSeasons BuyingSeason[]

  @@unique([entityId, code])
}

/// One purchase of one grade, for traceability and quality. Quantity only;
/// cost lives on the grade's balance.
model Lot {
  id                String   @id @default(cuid())
  entityId          String
  commodityId       String
  itemId            String
  locationId        String
  lotRef            String
  date              DateTime
  supplierContactId String?
  farmerName        String?
  community         String?
  district          String?
  /// Cashew: outturn (KOR, lb/80kg bag), moisture %, nut count per kg.
  kor               Decimal? @db.Decimal(6, 2)
  moisturePct       Decimal? @db.Decimal(5, 2)
  nutCount          Int?
  /// Cocoa: grade, moisture %, bean count per 100 g.
  cocoaGrade        String?
  beanCount         Int?
  gramsIn           BigInt
  /// Cumulative weight recorded out at weigh-outs (shrinkage), not sales.
  gramsShrunk       BigInt   @default(0)
  landedCostMinor   BigInt   @default(0)
  documentLineId    String?  @unique
  note              String?
  createdById       String?
  createdAt         DateTime @default(now())

  entity        Entity                 @relation(fields: [entityId], references: [id])
  commodity     Commodity              @relation(fields: [commodityId], references: [id])
  item          Item                   @relation(fields: [itemId], references: [id])
  location      StockLocation          @relation(fields: [locationId], references: [id])
  supplier      Contact?               @relation(fields: [supplierContactId], references: [id])
  documentLine  DocumentLine?          @relation(fields: [documentLineId], references: [id])
  createdBy     User?                  @relation(fields: [createdById], references: [id])
  movements     StockMovement[]
  landedCosts   LandedCostAllocation[]
  agentPurchase AgentPurchase?

  @@unique([entityId, lotRef])
  @@index([entityId, date])
  @@index([entityId, itemId])
}

enum LandedCostKind {
  TRANSPORT
  BAGS
  LOADING
  FUMIGATION
  LEVY
  COMMISSION
}

/// A landed-cost bill line's share for one lot: chosen at draft time, valued
/// at posting pro rata by the lot's weight in.
model LandedCostAllocation {
  id             String @id @default(cuid())
  entityId       String
  documentLineId String
  lotId          String
  valueMinor     BigInt @default(0)

  entity       Entity       @relation(fields: [entityId], references: [id])
  documentLine DocumentLine @relation(fields: [documentLineId], references: [id])
  lot          Lot          @relation(fields: [lotId], references: [id])

  @@unique([documentLineId, lotId])
}

model BuyingAgent {
  id                String   @id @default(cuid())
  entityId          String
  name              String
  phone             String?
  /// Where this agent's purchases are received by default.
  defaultLocationId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  entity          Entity               @relation(fields: [entityId], references: [id])
  defaultLocation StockLocation?       @relation(fields: [defaultLocationId], references: [id])
  floats          FloatAdvance[]
  purchases       AgentPurchase[]
  labour          FloatLabourPayment[]

  @@index([entityId])
}

enum FloatStatus {
  OPEN
  RECONCILED
}

/// Cash advanced to an agent to buy from farmers: a receivable until the
/// purchases posted plus cash returned equal the amount advanced.
model FloatAdvance {
  id             String      @id @default(cuid())
  entityId       String
  agentId        String
  date           DateTime
  amountMinor    BigInt
  /// Null for an opening balance: the cash left before the cut-over date.
  bankAccountId  String?
  status         FloatStatus @default(OPEN)
  journalEntryId String?     @unique
  reconciledAt   DateTime?
  reconciledById String?
  createdById    String?
  createdAt      DateTime    @default(now())

  entity       Entity               @relation(fields: [entityId], references: [id])
  agent        BuyingAgent          @relation(fields: [agentId], references: [id])
  bankAccount  BankAccount?         @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry?        @relation(fields: [journalEntryId], references: [id])
  createdBy    User?                @relation("FloatCreatedBy", fields: [createdById], references: [id])
  reconciledBy User?                @relation("FloatReconciledBy", fields: [reconciledById], references: [id])
  purchases    AgentPurchase[]
  returns      FloatReturn[]
  labour       FloatLabourPayment[]

  @@index([entityId, status])
}

model FloatReturn {
  id             String   @id @default(cuid())
  entityId       String
  floatId        String
  date           DateTime
  amountMinor    BigInt
  bankAccountId  String
  journalEntryId String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id])
  float        FloatAdvance  @relation(fields: [floatId], references: [id])
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
}

enum AgentPurchaseStatus {
  PENDING
  POSTED
  REJECTED
}

/// A purchase an agent made from a farmer, entered on a phone (possibly
/// offline) and synced. clientRef makes a resend harmless. Posting it
/// receives the stock against the agent's float and creates the lot.
model AgentPurchase {
  id             String              @id @default(cuid())
  entityId       String
  agentId        String
  floatId        String?
  clientRef      String
  date           DateTime
  farmerId       String?
  farmerName     String
  community      String?
  district       String?
  itemId         String
  locationId     String
  bags           Decimal?            @db.Decimal(10, 2)
  grams          BigInt
  priceMinor     BigInt
  paymentMethod  PaymentMethod       @default(CASH)
  /// Paid from the agent's float now, or left payable to the farmer and settled
  /// in a bulk payment batch later.
  settlement     PurchaseSettlement  @default(FLOAT)
  /// Evidence: the transfer reference, and for cash the farmer's signature or
  /// thumbprint captured on the agent's device.
  paymentRef     String?
  evidenceKind   PaymentEvidence?
  evidenceData   String?
  evidenceAt     DateTime?
  /// Fixed at posting: advance recovered from this purchase and the net payable.
  recoveredMinor BigInt              @default(0)
  payableMinor   BigInt              @default(0)
  kor            Decimal?            @db.Decimal(6, 2)
  moisturePct    Decimal?            @db.Decimal(5, 2)
  nutCount       Int?
  cocoaGrade     String?
  beanCount      Int?
  note           String?
  status         AgentPurchaseStatus @default(PENDING)
  rejectReason   String?
  lotId          String?             @unique
  journalEntryId String?             @unique
  syncedAt       DateTime            @default(now())
  createdById    String?
  postedById     String?
  postedAt       DateTime?

  entity       Entity            @relation(fields: [entityId], references: [id])
  agent        BuyingAgent       @relation(fields: [agentId], references: [id])
  float        FloatAdvance?     @relation(fields: [floatId], references: [id])
  farmer       Farmer?           @relation(fields: [farmerId], references: [id])
  item         Item              @relation(fields: [itemId], references: [id])
  payments     FarmerPayment[]
  recoveries   AdvanceRecovery[]
  location     StockLocation     @relation(fields: [locationId], references: [id])
  lot          Lot?              @relation(fields: [lotId], references: [id])
  journalEntry JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  createdBy    User?             @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  postedBy     User?             @relation("PurchasePostedBy", fields: [postedById], references: [id])

  @@unique([entityId, clientRef])
  @@index([entityId, status])
  @@index([agentId, status])
}

// --- sales contracts ----------------------------------------------------------------
//
// A contract sells a quantity of one grade to a buyer at a price per unit in
// a currency, for delivery in a period on stated terms. Deliveries draw
// stock at the location's weighted average and recognise revenue on
// delivery or on acceptance, as the contract says. Selling costs come from
// bill lines attributed to the contract. LBC mode reshapes the journals
// for deliveries to COCOBOD's CMC.

enum RevenuePresentation {
  GROSS
  NET
}

enum ContractStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum RevenueRecognition {
  DELIVERY
  ACCEPTANCE
}

enum DeliveryStatus {
  DELIVERED
  AWAITING_ACCEPTANCE
  ACCEPTED
  /// Delivered before the cut-over date: counts toward quantity, carries no revenue or cost here.
  BEFORE_CUTOVER
}

enum SellingCostKind {
  TRANSPORT_TO_BUYER
  PORT_HANDLING
  EXPORT_PERMIT
  LEVY
  OTHER
}

model SalesContract {
  id             String             @id @default(cuid())
  entityId       String
  contractNo     String
  buyerContactId String
  commodityId    String
  itemId         String
  quantityGrams  BigInt
  /// Price per priceUnit in the contract currency, minor units.
  priceMinor     BigInt
  priceUnit      StockUnit          @default(KG)
  currency       Currency           @default(GHS)
  /// The rate the contract was priced at (functional per 1 unit of currency); null for functional-currency contracts.
  contractRate   Decimal?           @db.Decimal(20, 10)
  deliveryTerms  String
  deliveryFrom   DateTime
  deliveryTo     DateTime
  recognizeOn    RevenueRecognition @default(DELIVERY)
  /// Domestic or export: decides the sales account.
  saleType       SaleType           @default(DOMESTIC)
  /// LBC mode: a contract with COCOBOD's CMC at the producer price.
  isCmc          Boolean            @default(false)
  status         ContractStatus     @default(OPEN)
  note           String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  entity       Entity                @relation(fields: [entityId], references: [id])
  buyer        Contact               @relation(fields: [buyerContactId], references: [id])
  commodity    Commodity             @relation(fields: [commodityId], references: [id])
  item         Item                  @relation(fields: [itemId], references: [id])
  createdBy    User?                 @relation(fields: [createdById], references: [id])
  deliveries   ContractDelivery[]
  sellingCosts ContractSellingCost[]
  costLines    DocumentLine[]

  @@unique([entityId, contractNo])
  @@index([entityId, status])
}

model ContractDelivery {
  id                       String         @id @default(cuid())
  entityId                 String
  contractId               String
  deliveryNo               Int
  date                     DateTime
  locationId               String
  grams                    BigInt
  /// Where it went (CMC take-over centre, port, buyer's warehouse).
  destination              String?
  /// Fixed at posting: revenue in the contract currency and in functional at the delivery-date rate.
  rate                     Decimal        @default(1) @db.Decimal(20, 10)
  revenueTxnMinor          BigInt
  revenueMinor             BigInt
  /// Cost of the stock drawn, functional.
  costMinor                BigInt
  /// LBC mode: the two allowances, functional.
  marginMinor              BigInt         @default(0)
  haulageMinor             BigInt         @default(0)
  status                   DeliveryStatus @default(DELIVERED)
  journalEntryId           String?        @unique
  acceptanceJournalEntryId String?        @unique
  acceptedAt               DateTime?
  acceptedById             String?
  note                     String?
  createdById              String?
  createdAt                DateTime       @default(now())

  entity            Entity          @relation(fields: [entityId], references: [id])
  contract          SalesContract   @relation(fields: [contractId], references: [id])
  location          StockLocation   @relation(fields: [locationId], references: [id])
  journalEntry      JournalEntry?   @relation("DeliveryJournal", fields: [journalEntryId], references: [id])
  acceptanceJournal JournalEntry?   @relation("AcceptanceJournal", fields: [acceptanceJournalEntryId], references: [id])
  createdBy         User?           @relation("DeliveryCreatedBy", fields: [createdById], references: [id])
  acceptedBy        User?           @relation("DeliveryAcceptedBy", fields: [acceptedById], references: [id])
  movements         StockMovement[]

  @@unique([contractId, deliveryNo])
  @@index([entityId, date])
}

/// A selling cost attributed to a contract, created when the bill line that
/// carries it is posted. Functional currency.
model ContractSellingCost {
  id             String          @id @default(cuid())
  entityId       String
  contractId     String
  kind           SellingCostKind
  description    String
  date           DateTime
  amountMinor    BigInt
  documentLineId String          @unique
  createdAt      DateTime        @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id])
  contract     SalesContract @relation(fields: [contractId], references: [id])
  documentLine DocumentLine  @relation(fields: [documentLineId], references: [id])

  @@index([contractId])
}

enum SeedFundKind {
  RECEIVED
  REPAID
  OFFSET
}

/// LBC mode: seed funds from COCOBOD are a liability, never income. Received
/// into a bank account; repaid from one; or offset against what CMC owes for
/// cocoa delivered.
model SeedFundMovement {
  id             String       @id @default(cuid())
  entityId       String
  kind           SeedFundKind
  date           DateTime
  amountMinor    BigInt
  bankAccountId  String?
  journalEntryId String?      @unique
  note           String?
  createdById    String?
  createdAt      DateTime     @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([entityId, date])
}

// --- opening balances ------------------------------------------------------------------
//
// Moving an entity onto the app at a cut-over date. The trial balance posts
// as one OPENING journal with every control account redirected to 3010
// Opening Balance Suspense; each detail import (open invoices and bills,
// stock, floats, farmer advances) posts to its control account against
// suspense, so the suspense balance is exactly the difference between the
// detail and the trial balance. An entity cannot go live while it is not
// zero, and nothing here can be imported once it is live.

enum OpeningSection {
  TRIAL_BALANCE
  INVOICES
  BILLS
  STOCK
  FLOATS
  FARMER_ADVANCES
  CONTRACTS
}

enum OpeningBatchStatus {
  DRAFT
  POSTED
}

/// One uploaded sheet: the parsed rows as JSON, kept as a draft until posted.
model OpeningBatch {
  id             String             @id @default(cuid())
  entityId       String
  section        OpeningSection
  fileName       String
  rowsJson       String
  rowCount       Int
  status         OpeningBatchStatus @default(DRAFT)
  journalEntryId String?            @unique
  postedAt       DateTime?
  createdById    String?
  createdAt      DateTime           @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([entityId, section, status])
}

enum FarmerAdvanceStatus {
  OPEN
  SETTLED
}

/// Money advanced to a farmer against produce to come. A receivable.
model FarmerAdvance {
  id             String              @id @default(cuid())
  entityId       String
  farmerId       String?
  farmerName     String
  community      String?
  district       String?
  date           DateTime
  amountMinor    BigInt
  settledMinor   BigInt              @default(0)
  status         FarmerAdvanceStatus @default(OPEN)
  journalEntryId String?             @unique
  note           String?
  createdById    String?
  createdAt      DateTime            @default(now())

  entity       Entity            @relation(fields: [entityId], references: [id])
  farmer       Farmer?           @relation(fields: [farmerId], references: [id])
  journalEntry JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  createdBy    User?             @relation(fields: [createdById], references: [id])
  recoveries   AdvanceRecovery[]

  @@index([entityId, status])
}

// --- mobile money, farmer payments and advances -------------------------------------
//
// A mobile money wallet is an ordinary bank account with a provider and a
// number, so it posts and reconciles like any other. Statements are imported
// with a named column mapping per provider; the transaction fee and any levy
// on a line are split off and posted to charges, so the line matches the
// amount that actually moved.
//
// Farmers may be paid on the spot from the agent's float, or left payable and
// settled in a bulk payment batch exported for the provider. A pre-season
// advance is a receivable recovered automatically from what the farmer is
// next paid.

enum BankAccountKind {
  BANK
  MOBILE_MONEY
  CASH
}

/// Money owed to a farmer for produce already received, and the account the
/// advances sit in, are both fixed codes; see src/lib/momo.ts.
enum PurchaseSettlement {
  /// Paid immediately from the agent's float.
  FLOAT
  /// Left payable to the farmer, settled in a payment batch.
  PAYABLE
}

enum PaymentEvidence {
  SIGNATURE
  THUMBPRINT
  /// A mobile money transfer is evidenced by its reference.
  REFERENCE
}

model Farmer {
  id           String   @id @default(cuid())
  entityId     String
  name         String
  phone        String?
  community    String?
  district     String?
  /// The wallet the farmer is paid into, when they are paid by mobile money.
  walletNumber String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entity    Entity          @relation(fields: [entityId], references: [id])
  purchases AgentPurchase[]
  advances  FarmerAdvance[]
  payments  FarmerPayment[]

  @@unique([entityId, name])
  @@index([entityId, isActive])
}

/// An advance recovered from one purchase. Append-only.
model AdvanceRecovery {
  id          String   @id @default(cuid())
  entityId    String
  advanceId   String
  purchaseId  String
  amountMinor BigInt
  createdAt   DateTime @default(now())

  advance  FarmerAdvance @relation(fields: [advanceId], references: [id])
  purchase AgentPurchase @relation(fields: [purchaseId], references: [id])

  @@unique([advanceId, purchaseId])
  @@index([entityId])
}

enum PaymentBatchStatus {
  DRAFT
  EXPORTED
  PAID
}

/// Many farmers paid at once: exported for bulk mobile money disbursement,
/// then matched to the statement in one step when it clears.
model FarmerPaymentBatch {
  id                       String             @id @default(cuid())
  entityId                 String
  reference                String
  date                     DateTime
  bankAccountId            String
  status                   PaymentBatchStatus @default(DRAFT)
  totalMinor               BigInt             @default(0)
  feeMinor                 BigInt             @default(0)
  exportedAt               DateTime?
  paidAt                   DateTime?
  journalEntryId           String?            @unique
  settlementJournalEntryId String?            @unique
  note                     String?
  createdById              String?
  paidById                 String?
  createdAt                DateTime           @default(now())

  entity            Entity          @relation(fields: [entityId], references: [id])
  bankAccount       BankAccount     @relation(fields: [bankAccountId], references: [id])
  journalEntry      JournalEntry?   @relation("BatchJournal", fields: [journalEntryId], references: [id])
  settlementJournal JournalEntry?   @relation("BatchSettlementJournal", fields: [settlementJournalEntryId], references: [id])
  createdBy         User?           @relation("BatchCreatedBy", fields: [createdById], references: [id])
  paidBy            User?           @relation("BatchPaidBy", fields: [paidById], references: [id])
  payments          FarmerPayment[]
  statementLines    StatementLine[]

  @@unique([entityId, reference])
  @@index([entityId, status])
}

model FarmerPayment {
  id           String  @id @default(cuid())
  entityId     String
  batchId      String
  farmerId     String
  purchaseId   String?
  amountMinor  BigInt
  walletNumber String?
  paymentRef   String?

  entity   Entity             @relation(fields: [entityId], references: [id])
  batch    FarmerPaymentBatch @relation(fields: [batchId], references: [id])
  farmer   Farmer             @relation(fields: [farmerId], references: [id])
  purchase AgentPurchase?     @relation(fields: [purchaseId], references: [id])

  @@index([entityId, farmerId])
}

/// A named CSV column mapping for one provider's statement.
model StatementMapping {
  id                String   @id @default(cuid())
  entityId          String
  name              String
  /// Column headings, as they appear in the file.
  dateColumn        String
  descriptionColumn String
  referenceColumn   String?
  amountColumn      String?
  /// Some providers give money in and money out in separate columns.
  moneyInColumn     String?
  moneyOutColumn    String?
  feeColumn         String?
  levyColumn        String?
  balanceColumn     String?
  /// Rows whose description contains one of these (comma separated) are charges.
  chargeKeywords    String?
  dateFormat        String   @default("YYYY-MM-DD")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entity  Entity            @relation(fields: [entityId], references: [id])
  imports StatementImport[]

  @@unique([entityId, name])
}

model StatementImport {
  id                String    @id @default(cuid())
  entityId          String
  bankAccountId     String
  mappingId         String?
  fileName          String
  fromDate          DateTime?
  toDate            DateTime?
  lineCount         Int
  feeMinor          BigInt    @default(0)
  feeJournalEntryId String?   @unique
  createdById       String?
  createdAt         DateTime  @default(now())

  entity      Entity            @relation(fields: [entityId], references: [id])
  bankAccount BankAccount       @relation(fields: [bankAccountId], references: [id])
  mapping     StatementMapping? @relation(fields: [mappingId], references: [id])
  createdBy   User?             @relation(fields: [createdById], references: [id])
  lines       StatementLine[]

  @@index([entityId, bankAccountId])
}

enum StatementLineStatus {
  UNMATCHED
  MATCHED
  CHARGE
}

model StatementLine {
  id               String              @id @default(cuid())
  entityId         String
  importId         String
  bankAccountId    String
  date             DateTime
  description      String
  reference        String?
  /// Signed: positive money in, negative money out. Net of the fee and levy,
  /// which are posted separately to charges.
  amountMinor      BigInt
  feeMinor         BigInt              @default(0)
  levyMinor        BigInt              @default(0)
  balanceMinor     BigInt?
  status           StatementLineStatus @default(UNMATCHED)
  matchedBatchId   String?
  matchedPaymentId String?
  journalEntryId   String?
  note             String?
  createdAt        DateTime            @default(now())

  entity       Entity              @relation(fields: [entityId], references: [id])
  import       StatementImport     @relation(fields: [importId], references: [id])
  bankAccount  BankAccount         @relation(fields: [bankAccountId], references: [id])
  matchedBatch FarmerPaymentBatch? @relation(fields: [matchedBatchId], references: [id])
  journalEntry JournalEntry?       @relation(fields: [journalEntryId], references: [id])

  @@index([entityId, status])
  @@index([importId])
}

// --- grants -------------------------------------------------------------------
//
// A grant sits on top of the existing fund tracking: it names the restricted
// fund its money belongs to, so everything coded to the grant is coded to
// that fund as well. Amounts are in the donor currency; `rate` is what the
// award was made at and what the budget comparison converts by.

enum GrantStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// Chosen per grant by a person, never inferred: income the day it arrives,
/// or held as a liability and released as it is earned.
enum GrantIncomePolicy {
  ON_RECEIPT
  DEFERRED
}

enum GrantReportingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  FINAL_ONLY
}

/// What earned a release of deferred income.
enum GrantReleaseBasis {
  SPENDING
  CONDITION
}

enum InKindKind {
  GOODS
  SERVICES
  FACILITIES
}

model Grant {
  id                     String                  @id @default(cuid())
  entityId               String
  code                   String
  name                   String
  donorContactId         String
  /// The restricted (or unrestricted) fund this money belongs to.
  fundId                 String?
  projectId              String?
  /// The donor currency. The award and every budget line are in it.
  currency               Currency
  amountMinor            BigInt
  /// Functional units per one unit of the donor currency, fixed at award.
  rate                   Decimal                 @default(1) @db.Decimal(20, 10)
  startDate              DateTime                @db.Date
  endDate                DateTime                @db.Date
  restricted             Boolean                 @default(true)
  incomePolicy           GrantIncomePolicy       @default(ON_RECEIPT)
  reportingFrequency     GrantReportingFrequency @default(QUARTERLY)
  /// The donor own anchor: their periods run from here, not our year end.
  reportingStartDate     DateTime?               @db.Date
  reportingDueDays       Int                     @default(30)
  /// A budget line below this share of its time-prorated budget is flagged.
  underspendThresholdPct Int                     @default(75)
  status                 GrantStatus             @default(DRAFT)
  note                   String?
  createdById            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  entity        Entity                @relation(fields: [entityId], references: [id])
  donor         Contact               @relation(fields: [donorContactId], references: [id])
  fund          Fund?                 @relation(fields: [fundId], references: [id])
  project       Project?              @relation(fields: [projectId], references: [id])
  createdBy     User?                 @relation(fields: [createdById], references: [id])
  budgetLines   GrantBudgetLine[]
  conditions    GrantCondition[]
  receipts      GrantReceipt[]
  releases      GrantRelease[]
  inKind        InKindContribution[]
  staffTime     StaffTimeAllocation[]
  journalLines  JournalLine[]
  documentLines DocumentLine[]

  @@unique([entityId, code])
  @@index([entityId, status])
}

/// What the donor agreed the money would be spent on, in their currency.
model GrantBudgetLine {
  id          String   @id @default(cuid())
  entityId    String
  grantId     String
  code        String
  name        String
  accountId   String
  budgetMinor BigInt   @default(0)
  note        String?
  createdAt   DateTime @default(now())

  entity        Entity                @relation(fields: [entityId], references: [id])
  grant         Grant                 @relation(fields: [grantId], references: [id])
  account       Account               @relation(fields: [accountId], references: [id])
  journalLines  JournalLine[]
  documentLines DocumentLine[]
  inKind        InKindContribution[]
  staffTime     StaffTimeAllocation[]

  @@unique([grantId, code])
  @@index([entityId, grantId])
}

/// Something the donor requires. Under the deferred policy, meeting one can
/// release a stated amount of income.
model GrantCondition {
  id          String    @id @default(cuid())
  entityId    String
  grantId     String
  description String
  dueDate     DateTime? @db.Date
  metAt       DateTime?
  metById     String?
  note        String?
  createdAt   DateTime  @default(now())

  entity   Entity         @relation(fields: [entityId], references: [id])
  grant    Grant          @relation(fields: [grantId], references: [id])
  metBy    User?          @relation(fields: [metById], references: [id])
  releases GrantRelease[]

  @@index([entityId, grantId])
}

/// Money in from the donor, in their currency and ours.
model GrantReceipt {
  id             String   @id @default(cuid())
  entityId       String
  grantId        String
  date           DateTime @db.Date
  txnCurrency    Currency
  txnAmountMinor BigInt
  rate           Decimal  @default(1) @db.Decimal(20, 10)
  amountMinor    BigInt
  bankAccountId  String
  reference      String?
  journalEntryId String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id])
  grant        Grant         @relation(fields: [grantId], references: [id])
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([entityId, grantId])
}

/// Deferred income earned and moved into income. Only the deferred policy
/// produces these.
model GrantRelease {
  id             String            @id @default(cuid())
  entityId       String
  grantId        String
  date           DateTime          @db.Date
  amountMinor    BigInt
  basis          GrantReleaseBasis
  conditionId    String?
  note           String?
  journalEntryId String?           @unique
  createdById    String?
  createdAt      DateTime          @default(now())

  entity       Entity          @relation(fields: [entityId], references: [id])
  grant        Grant           @relation(fields: [grantId], references: [id])
  condition    GrantCondition? @relation(fields: [conditionId], references: [id])
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  createdBy    User?           @relation(fields: [createdById], references: [id])

  @@index([entityId, grantId])
}

/// Donated goods, services or facilities, grossed up so the donor can see
/// what they gave without the surplus moving.
model InKindContribution {
  id             String     @id @default(cuid())
  entityId       String
  grantId        String?
  budgetLineId   String?
  date           DateTime   @db.Date
  description    String
  kind           InKindKind @default(GOODS)
  valueMinor     BigInt
  /// How the value was arrived at: donors ask.
  basis          String?
  donorContactId String?
  journalEntryId String?    @unique
  createdById    String?
  createdAt      DateTime   @default(now())

  entity       Entity           @relation(fields: [entityId], references: [id])
  grant        Grant?           @relation(fields: [grantId], references: [id])
  budgetLine   GrantBudgetLine? @relation(fields: [budgetLineId], references: [id])
  donor        Contact?         @relation(fields: [donorContactId], references: [id])
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  createdBy    User?            @relation(fields: [createdById], references: [id])

  @@index([entityId, grantId])
}

/// Staff time charged to a grant. Posting it debits and credits the same
/// salary account, so the total cost is unchanged and only the analysis moves.
model StaffTimeAllocation {
  id               String   @id @default(cuid())
  entityId         String
  grantId          String
  budgetLineId     String?
  personName       String
  role             String?
  periodStart      DateTime @db.Date
  periodEnd        DateTime @db.Date
  hours            Decimal  @db.Decimal(10, 2)
  rateMinorPerHour BigInt
  valueMinor       BigInt
  accountId        String
  note             String?
  journalEntryId   String?  @unique
  createdById      String?
  createdAt        DateTime @default(now())

  entity       Entity           @relation(fields: [entityId], references: [id])
  grant        Grant            @relation(fields: [grantId], references: [id])
  budgetLine   GrantBudgetLine? @relation(fields: [budgetLineId], references: [id])
  account      Account          @relation(fields: [accountId], references: [id])
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  createdBy    User?            @relation(fields: [createdById], references: [id])

  @@index([entityId, grantId])
}

// --- cash flow forecasting -----------------------------------------------------
//
// The forecast itself is computed, never stored: it is only as good as the
// records behind it, and a stored copy would go stale the moment an invoice
// was paid. What is stored is what a person decides — the buying seasons,
// the recurring costs, and the scenarios with their assumptions and any
// lines added by hand.

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

/// When a commodity is bought, how heavily, and at what price. The forecast
/// spreads the volume across the season as a triangle peaking at peakDate,
/// so the working capital needed before anything is sold is visible.
model BuyingSeason {
  id              String   @id @default(cuid())
  entityId        String
  commodityId     String
  name            String
  startDate       DateTime @db.Date
  peakDate        DateTime @db.Date
  endDate         DateTime @db.Date
  /// What we expect to buy across the whole season.
  expectedGrams   BigInt   @default(0)
  /// What we expect to pay, minor units per kilogram.
  priceMinorPerKg BigInt   @default(0)
  currency        Currency @default(GHS)
  note            String?
  isActive        Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entity    Entity    @relation(fields: [entityId], references: [id])
  commodity Commodity @relation(fields: [commodityId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@unique([entityId, name])
  @@index([entityId, commodityId])
}

/// Payroll, rent and anything else that goes out on a rhythm.
model RecurringCost {
  id          String             @id @default(cuid())
  entityId    String
  name        String
  currency    Currency           @default(GHS)
  /// What goes out each time, as a positive amount.
  amountMinor BigInt
  frequency   RecurringFrequency @default(MONTHLY)
  startDate   DateTime           @db.Date
  endDate     DateTime?          @db.Date
  accountId   String?
  note        String?
  isActive    Boolean            @default(true)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  entity    Entity   @relation(fields: [entityId], references: [id])
  account   Account? @relation(fields: [accountId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@unique([entityId, name])
  @@index([entityId, isActive])
}

/// A set of assumptions to forecast under. One per entity is the baseline;
/// the rest are what-ifs to put beside it.
model CashScenario {
  id                  String   @id @default(cuid())
  entityId            String
  name                String
  isBaseline          Boolean  @default(false)
  /// Days later than due that customers actually pay.
  collectionDelayDays Int      @default(0)
  /// Percent of planned commodity price and volume; 100 leaves them alone.
  pricePct            Int      @default(100)
  volumePct           Int      @default(100)
  /// Days before a purchase that the float has to be with the agent.
  floatLeadDays       Int      @default(7)
  /// Below this, a week or month is flagged. In the functional currency.
  minimumCashMinor    BigInt   @default(0)
  note                String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  entity    Entity             @relation(fields: [entityId], references: [id])
  createdBy User?              @relation(fields: [createdById], references: [id])
  rates     CashScenarioRate[]
  lines     CashScenarioLine[]

  @@unique([entityId, name])
  @@index([entityId, isBaseline])
}

/// The rate a scenario converts one currency at for its combined view.
model CashScenarioRate {
  id         String   @id @default(cuid())
  entityId   String
  scenarioId String
  currency   Currency
  /// Functional units per one unit of the currency.
  rate       Decimal  @db.Decimal(20, 10)

  entity   Entity       @relation(fields: [entityId], references: [id])
  scenario CashScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, currency])
  @@index([entityId])
}

/// Anything the records do not know about: a loan drawdown, a grant we have
/// been promised but not signed, a one-off repair.
model CashScenarioLine {
  id          String   @id @default(cuid())
  entityId    String
  scenarioId  String
  date        DateTime @db.Date
  currency    Currency @default(GHS)
  /// Signed: positive is money in, negative is money out.
  amountMinor BigInt
  description String
  createdById String?
  createdAt   DateTime @default(now())

  entity    Entity       @relation(fields: [entityId], references: [id])
  scenario  CashScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id])

  @@index([entityId, scenarioId])
}

// --- fixed assets and tax ------------------------------------------------------
//
// Accounting and tax are kept apart. Depreciation is what the books say an
// asset lost; capital allowances are what the Revenue allows, on classes and
// rates that are entered as settings and never written into the code, because
// they change with the budget.

enum EntityTaxStatus {
  TAXABLE
  EXEMPT
  SPECIAL_RATE
}

enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE
}

enum AssetStatus {
  IN_USE
  DISPOSED
}

enum TaxAdjustmentKind {
  ADD_BACK
  DEDUCTION
  INCENTIVE
}

model FixedAsset {
  id                 String             @id @default(cuid())
  entityId           String
  code               String
  description        String
  category           String?
  purchaseDate       DateTime           @db.Date
  /// The month depreciation starts; usually the month it was bought.
  inServiceDate      DateTime           @db.Date
  costMinor          BigInt
  residualMinor      BigInt             @default(0)
  usefulLifeMonths   Int
  method             DepreciationMethod @default(STRAIGHT_LINE)
  supplierContactId  String?
  location           String?
  custodian          String?
  serialNumber       String?
  /// Which capital allowance pool it belongs to, for tax. Nothing to do with
  /// the depreciation above.
  allowanceClassId   String?
  /// Set when the asset came in with the opening balances, so its
  /// accumulated depreciation starts from a figure rather than from nil.
  openingAccumulated BigInt             @default(0)
  status             AssetStatus        @default(IN_USE)
  note               String?
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  entity         Entity                 @relation(fields: [entityId], references: [id])
  supplier       Contact?               @relation(fields: [supplierContactId], references: [id])
  allowanceClass CapitalAllowanceClass? @relation(fields: [allowanceClassId], references: [id])
  createdBy      User?                  @relation(fields: [createdById], references: [id])
  depreciation   DepreciationLine[]
  disposal       AssetDisposal?

  @@unique([entityId, code])
  @@index([entityId, status])
}

/// One month of depreciation across every asset, posted as one journal.
model DepreciationRun {
  id             String   @id @default(cuid())
  entityId       String
  /// YYYY-MM.
  period         String
  totalMinor     BigInt   @default(0)
  journalEntryId String?  @unique
  postedById     String?
  postedAt       DateTime @default(now())

  entity       Entity             @relation(fields: [entityId], references: [id])
  journalEntry JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  postedBy     User?              @relation(fields: [postedById], references: [id])
  lines        DepreciationLine[]

  @@unique([entityId, period])
}

model DepreciationLine {
  id          String @id @default(cuid())
  entityId    String
  runId       String
  assetId     String
  amountMinor BigInt

  run   DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset FixedAsset      @relation(fields: [assetId], references: [id])

  @@unique([runId, assetId])
  @@index([entityId, assetId])
}

/// Selling or scrapping an asset. The gain or loss is fixed here and never
/// recomputed: it is what the books said on the day.
model AssetDisposal {
  id             String   @id @default(cuid())
  entityId       String
  assetId        String   @unique
  date           DateTime @db.Date
  proceedsMinor  BigInt   @default(0)
  bankAccountId  String?
  bookValueMinor BigInt
  gainLossMinor  BigInt
  note           String?
  journalEntryId String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id])
  asset        FixedAsset    @relation(fields: [assetId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([entityId, date])
}

/// A capital allowance class and its rate, as the person enters them. Ghana's
/// classes and rates change with the budget, so none of this is in the code.
model CapitalAllowanceClass {
  id        String             @id @default(cuid())
  entityId  String
  code      String
  name      String
  /// Percent a year.
  ratePct   Decimal            @db.Decimal(6, 3)
  method    DepreciationMethod @default(REDUCING_BALANCE)
  note      String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  entity Entity        @relation(fields: [entityId], references: [id])
  assets FixedAsset[]
  pools  TaxYearPool[]

  @@unique([entityId, code])
}

/// A year of tax, with the rate and the position brought forward. The rate is
/// a setting on the year, so a change of rate applies to the years it should.
model TaxYear {
  id                      String    @id @default(cuid())
  entityId                String
  /// A label the person recognises, e.g. "2026".
  label                   String
  startDate               DateTime  @db.Date
  endDate                 DateTime  @db.Date
  ratePct                 Decimal   @db.Decimal(6, 3)
  lossBroughtForwardMinor BigInt    @default(0)
  /// What provisional instalments are based on. Set by the person; it is an
  /// estimate made before the year is finished.
  estimatedLiabilityMinor BigInt    @default(0)
  /// Fixed when the computation is posted; nil until then.
  taxChargeMinor          BigInt?
  chargeJournalEntryId    String?   @unique
  postedAt                DateTime?
  note                    String?
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  entity        Entity                  @relation(fields: [entityId], references: [id])
  chargeJournal JournalEntry?           @relation(fields: [chargeJournalEntryId], references: [id])
  createdBy     User?                   @relation(fields: [createdById], references: [id])
  adjustments   TaxAdjustment[]
  pools         TaxYearPool[]
  provisional   ProvisionalTaxPayment[]

  @@unique([entityId, label])
  @@index([entityId, startDate])
}

/// What a class brought forward into a year. Additions and disposals in the
/// year are read from the register; only the opening figure is entered.
model TaxYearPool {
  id           String @id @default(cuid())
  entityId     String
  taxYearId    String
  classId      String
  openingMinor BigInt @default(0)

  taxYear TaxYear               @relation(fields: [taxYearId], references: [id], onDelete: Cascade)
  class   CapitalAllowanceClass @relation(fields: [classId], references: [id])

  @@unique([taxYearId, classId])
  @@index([entityId])
}

/// An add-back, a deduction or an incentive, entered by the person with the
/// reason it is there.
model TaxAdjustment {
  id          String            @id @default(cuid())
  entityId    String
  taxYearId   String
  kind        TaxAdjustmentKind
  description String
  amountMinor BigInt
  note        String?
  createdAt   DateTime          @default(now())

  entity  Entity  @relation(fields: [entityId], references: [id])
  taxYear TaxYear @relation(fields: [taxYearId], references: [id], onDelete: Cascade)

  @@index([entityId, taxYearId])
}

/// A quarterly instalment paid against the estimate.
model ProvisionalTaxPayment {
  id             String   @id @default(cuid())
  entityId       String
  taxYearId      String
  quarter        Int
  date           DateTime @db.Date
  amountMinor    BigInt
  bankAccountId  String
  reference      String?
  journalEntryId String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id])
  taxYear      TaxYear       @relation(fields: [taxYearId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([entityId, taxYearId])
}

// --- attachments ---------------------------------------------------------------
//
// Files live in cloud storage, never in the database. What is here is where
// the file is, what it is, how big it was and its checksum — enough to find
// it, serve it and prove it has not changed.
//
// An attachment on a posted transaction cannot be removed. Evidence that can
// be taken away after the fact is not evidence.

enum AttachmentTargetKind {
  INVOICE
  BILL
  PAYMENT
  JOURNAL
  AGENT_PURCHASE
  STOCK_COUNT
  FIXED_ASSET
  /// Uploaded first, matched to a transaction later.
  INBOX
}

model Attachment {
  id           String               @id @default(cuid())
  entityId     String
  targetKind   AttachmentTargetKind @default(INBOX)
  /// The id of the thing it belongs to; null while it is in the inbox.
  targetId     String?
  /// Where the bytes are, inside the private bucket.
  storageKey   String               @unique
  fileName     String
  contentType  String
  byteSize     Int
  /// sha256 of the bytes as they were uploaded.
  checksum     String
  note         String?
  /// Set when it is matched out of the inbox, so the move is on the record.
  matchedAt    DateTime?
  uploadedById String?
  uploadedAt   DateTime             @default(now())

  entity     Entity @relation(fields: [entityId], references: [id])
  uploadedBy User?  @relation(fields: [uploadedById], references: [id])

  @@index([entityId, targetKind, targetId])
  @@index([entityId, uploadedAt])
}

/// At or above the threshold, that kind of transaction needs a document
/// attached before it can be posted. Set per entity by a person.
model AttachmentRule {
  id             String               @id @default(cuid())
  entityId       String
  targetKind     AttachmentTargetKind
  /// Zero means always.
  thresholdMinor BigInt               @default(0)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])

  @@unique([entityId, targetKind])
}

/// A request from a person to be told what is held about them, or to have
/// their personal details erased. Kept as the proof that the request was
/// answered, and as the link between a pseudonym and the request that
/// created it. Never deleted.
model DataSubjectRequest {
  id            String   @id @default(cuid())
  entityId      String
  /// ACCESS | ERASURE
  kind          String
  /// farmer | agent | contact | employee
  subjectKind   String
  /// The row the request is about: a Farmer id, a BuyingAgent id, a Contact
  /// id, or for staff the employee key on the payroll.
  subjectId     String
  /// What the person was called when the request came in. For an erasure
  /// this is the last place their real name is written down, so it is only
  /// ever shown to someone allowed to manage privacy.
  subjectRef    String
  /// Who asked, as they gave it, and anything they said.
  requestedBy   String
  note          String?
  /// Set on an erasure: the reference that replaced their name.
  pseudonym     String?
  /// How many stored values the erasure wrote over or emptied.
  fieldsChanged Int      @default(0)
  handledById   String?
  handledByName String
  createdAt     DateTime @default(now())

  entity    Entity @relation(fields: [entityId], references: [id])
  handledBy User?  @relation(fields: [handledById], references: [id])

  @@index([entityId, createdAt])
  @@index([entityId, subjectKind, subjectId])
}

/// A line of a project's budget.
///
/// The original figure is written once and never changed. A revision goes in
/// beside it, so a report can show the budget as it was agreed and the budget
/// as it stands now, and the difference between them.
model ProjectBudgetLine {
  id            String    @id @default(cuid())
  entityId      String
  projectId     String
  name          String
  /// Optional: the account this part of the budget is spent through.
  accountId     String?
  /// As first agreed. Never edited - a revision is the field below.
  originalMinor BigInt    @default(0)
  /// Null until the budget is revised.
  revisedMinor  BigInt?
  revisedAt     DateTime?
  note          String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entity  Entity   @relation(fields: [entityId], references: [id])
  project Project  @relation(fields: [projectId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@index([entityId, projectId])
}

/// A class of fixed asset and how it is depreciated by default, so adding an
/// asset does not mean remembering the rate. Editable; an asset keeps whatever
/// terms it was given, so changing this never restates anything already
/// depreciated.
model AssetCategory {
  id        String             @id @default(cuid())
  entityId  String
  name      String
  /// Percent a year, straight line unless the method says otherwise.
  ratePct   Decimal            @db.Decimal(6, 3)
  method    DepreciationMethod @default(STRAIGHT_LINE)
  /// The account the cost of this class sits in.
  accountId String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  entity  Entity   @relation(fields: [entityId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@unique([entityId, name])
}

/// The tax rates and the registration threshold, per entity.
///
/// Changing a rate does not restate anything already posted: a posted journal
/// holds the figures it was posted with. It applies to what is calculated
/// from here on.
model TaxRateSetting {
  id                         String   @id @default(cuid())
  entityId                   String   @unique
  vatPct                     Decimal  @default(15) @db.Decimal(6, 3)
  nhilPct                    Decimal  @default(2.5) @db.Decimal(6, 3)
  getFundPct                 Decimal  @default(2.5) @db.Decimal(6, 3)
  /// Turnover in a rolling twelve months above which registration is required.
  registrationThresholdMinor BigInt   @default(75000000)
  updatedAt                  DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])
}

/// One statutory payroll figure — a PAYE band, an SSNIT rate, a relief, a
/// concessionary rate, a choice the law leaves open — and the dates it was in
/// force.
///
/// National reference data, not a transaction: the same law applies to every
/// entity, so there is no entityId here and no per-entity copy. This is the
/// one exception to the entityId rule, recorded in CLAUDE.md. What is
/// per-entity about payroll lives in PayrollSetting.
///
/// Rates are data, never code. A payroll run reads the rows in force on the
/// last day of its own pay period, so re-running an old month reproduces it
/// exactly however the figures have moved since. What each key means, and
/// whether it holds a rate, an amount, a count or a choice, is the catalogue
/// in src/lib/payroll-rates.ts.
///
/// A change is a new row from its own effective date, with the old one closed
/// the day before — never an edit that rewrites history. A row is corrected in
/// place only while it is still a placeholder, and then by withdrawing it.
model StatutoryRate {
  id              String    @id @default(cuid())
  /// e.g. 'paye.band', 'ssnit.employee'. A string, so a new kind of rate
  /// needs no schema change.
  key             String
  /// Order within a set that has several rows: the PAYE bands, lowest first.
  sequence        Int       @default(0)
  /// Any date; the screen offers the first of a month.
  effectiveFrom   DateTime  @db.Date
  /// Null while still in force.
  effectiveTo     DateTime? @db.Date
  /// Hundredths of a percent: 1750 is 17.5%. Integer, so no rounding drift.
  rateBasisPoints Int?
  /// Pesewas a month: a band width, a relief, a cap.
  amountMinor     BigInt?
  /// The most a relief can be claimed for, e.g. three children.
  maxCount        Int?
  /// For a key whose catalogue entry is a choice, e.g. 'progressive' | 'flat'.
  choice          String?
  /// For a deadline: the day of the month after the pay period it falls due.
  dayOfMonth      Int?
  /// True until somebody has checked the figure against GRA or SSNIT. A run
  /// using a placeholder can be calculated but not approved.
  isPlaceholder   Boolean   @default(true)
  /// Where the figure was verified: a GRA notice, an SSNIT circular.
  source          String?
  note            String?
  /// Set when a placeholder is corrected: the row is kept, never deleted, and
  /// never read again. Only an unverified row can be withdrawn.
  withdrawnAt     DateTime?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([key, effectiveFrom])
}

enum PayrollProrationBasis {
  CALENDAR_DAYS
  WORKING_DAYS
}

/// How one entity runs payroll. Everything statutory is in StatutoryRate;
/// this is only what the entity itself decides.
model PayrollSetting {
  id             String                @id @default(cuid())
  entityId       String                @unique
  /// Not every entity runs payroll. Off until an Owner switches it on.
  payrollEnabled Boolean               @default(false)
  /// Day of the month staff are paid; a day past the month end means its last day.
  payDay         Int                   @default(28)
  /// Whether employees may make voluntary tier 3 contributions through payroll.
  tier3Offered   Boolean               @default(false)
  /// How a part month is paid when someone joins or leaves part way through.
  prorationBasis PayrollProrationBasis @default(CALENDAR_DAYS)
  updatedById    String?
  updatedAt      DateTime              @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])
}

// --- payroll ---------------------------------------------------------------------
//
// Calculated in the app: src/lib/payroll-engine.ts works out one employee's
// pay from the statutory rates in force; src/lib/payroll-run.ts turns a
// month of it into a journal and the amounts owed to GRA, SSNIT and staff.

enum EmploymentType {
  PERMANENT
  CONTRACT
  /// Recorded, but refused by the calculation until the rules are confirmed.
  CASUAL
}

enum TaxResidency {
  RESIDENT
  NON_RESIDENT
}

enum EmployeePayMethod {
  BANK
  MOBILE_MONEY
}

/// A member of staff on one entity's payroll.
model Employee {
  id                  String            @id @default(cuid())
  entityId            String
  staffNumber         String
  name                String
  /// For emailing payslips. Encrypted at rest.
  email               String?
  tin                 String?
  ssnitNumber         String?
  startDate           DateTime          @db.Date
  /// Null while employed. Nothing is deleted: a leaver keeps their record.
  endDate             DateTime?         @db.Date
  employmentType      EmploymentType    @default(PERMANENT)
  residency           TaxResidency      @default(RESIDENT)
  department          String?
  /// Where gross pay is charged.
  expenseAccountId    String
  payMethod           EmployeePayMethod @default(BANK)
  bankName            String?
  /// Encrypted at rest.
  bankAccountNumber   String?
  /// Encrypted at rest.
  momoNumber          String?
  /// Monthly basic salary: always pensionable, kept apart from allowances.
  basicMinor          BigInt
  juniorStaffOvertime Boolean           @default(false)
  /// Voluntary tier 3 each month, where the entity offers it.
  tier3Minor          BigInt            @default(0)
  /// Benefit kinds from src/lib/payroll-engine.ts, e.g. 'vehicle-fuel'.
  benefitsInKind      String[]          @default([])
  /// Personal reliefs registered for the employee; amounts come from the rates.
  marriageRelief      Boolean           @default(false)
  childrenInEducation Int               @default(0)
  agedDependants      Int               @default(0)
  disabilityRelief    Boolean           @default(false)
  oldAgeRelief        Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  entity         Entity               @relation(fields: [entityId], references: [id])
  expenseAccount Account              @relation(fields: [expenseAccountId], references: [id])
  allowances     EmployeeAllowance[]
  allocations    EmployeeAllocation[]
  loans          StaffLoan[]
  payLines       PayRunLine[]

  @@unique([entityId, staffNumber])
  @@index([entityId])
}

/// A named allowance on an employee's pay. Ended, never deleted.
model EmployeeAllowance {
  id          String    @id @default(cuid())
  entityId    String
  employeeId  String
  name        String
  amountMinor BigInt
  taxable     Boolean   @default(true)
  /// In the SSNIT base. Off unless the contract says so.
  pensionable Boolean   @default(false)
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  entity   Entity   @relation(fields: [entityId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([entityId, employeeId])
}

/// One share of an employee's cost charged to a project. The live shares add
/// to 100%; a new split ends the old rows rather than deleting them.
model EmployeeAllocation {
  id               String    @id @default(cuid())
  entityId         String
  employeeId       String
  projectId        String
  /// Hundredths of a percent: 10000 is all of it.
  shareBasisPoints Int
  endedAt          DateTime?
  createdAt        DateTime  @default(now())

  entity   Entity   @relation(fields: [entityId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])

  @@index([entityId, employeeId])
}

/// A loan or advance to a member of staff, repaid from pay. What is left is
/// the principal less instalments on posted, unreversed pay runs.
model StaffLoan {
  id              String   @id @default(cuid())
  entityId        String
  employeeId      String
  /// 'loan' | 'advance'
  kind            String   @default("loan")
  description     String
  principalMinor  BigInt
  instalmentMinor BigInt
  issuedOn        DateTime @db.Date
  /// YYYY-MM: the first pay period an instalment is taken.
  firstPeriod     String
  bankAccountId   String
  journalEntryId  String?  @unique
  createdById     String?
  createdAt       DateTime @default(now())

  entity       Entity            @relation(fields: [entityId], references: [id])
  employee     Employee          @relation(fields: [employeeId], references: [id])
  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  repayments   PayRunDeduction[]

  @@index([entityId, employeeId])
}

enum PayRunStatus {
  /// Everything recalculable.
  DRAFT
  /// Figures locked; waiting to post.
  APPROVED
  /// Journal written.
  POSTED
  /// Posted, then undone by a recorded reversing entry. The period can run again.
  REVERSED
}

/// One pay period for one entity: draft, approved, posted.
model PayRun {
  id                     String       @id @default(cuid())
  entityId               String
  /// YYYY-MM.
  period                 String
  /// 1 for the first run of a period; a period whose run was reversed runs again as 2.
  sequence               Int          @default(1)
  status                 PayRunStatus @default(DRAFT)
  payDate                DateTime     @db.Date
  calculatedAt           DateTime?
  approvedById           String?
  approvedAt             DateTime?
  postedById             String?
  postedAt               DateTime?
  journalEntryId         String?      @unique
  reversalJournalEntryId String?      @unique
  reversedById           String?
  reversedAt             DateTime?
  reversalReason         String?
  createdById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  entity          Entity              @relation(fields: [entityId], references: [id])
  journalEntry    JournalEntry?       @relation("PayRunJournal", fields: [journalEntryId], references: [id])
  reversalJournal JournalEntry?       @relation("PayRunReversal", fields: [reversalJournalEntryId], references: [id])
  lines           PayRunLine[]
  remittances     PayrollRemittance[]

  @@unique([entityId, period, sequence])
  @@index([entityId, status])
}

/// One employee in one pay run: what went in, what came out, and the working.
model PayRunLine {
  id                   String  @id @default(cuid())
  entityId             String
  runId                String
  employeeId           String
  /// Entered for this period only.
  bonusInputMinor      BigInt  @default(0)
  overtimeInputMinor   BigInt  @default(0)
  /// Why this employee could not be calculated, e.g. a casual worker. Blocks approval.
  error                String?
  /// The PayInput and project split used, as JSON: what a re-run starts from.
  inputsJson           String?
  /// The full PayResult with its working and the rates used, as JSON.
  resultJson           String?
  daysEmployed         Int     @default(0)
  basicMinor           BigInt  @default(0)
  allowancesMinor      BigInt  @default(0)
  nonTaxableMinor      BigInt  @default(0)
  bonusMinor           BigInt  @default(0)
  overtimeMinor        BigInt  @default(0)
  grossMinor           BigInt  @default(0)
  ssnitBaseMinor       BigInt  @default(0)
  employeeSsnitMinor   BigInt  @default(0)
  tier3Minor           BigInt  @default(0)
  benefitsMinor        BigInt  @default(0)
  reliefsMinor         BigInt  @default(0)
  chargeableMinor      BigInt  @default(0)
  payeMinor            BigInt  @default(0)
  bonusTaxMinor        BigInt  @default(0)
  overtimeTaxMinor     BigInt  @default(0)
  bonusConcessionMinor BigInt  @default(0)
  deductionsMinor      BigInt  @default(0)
  netMinor             BigInt  @default(0)
  employerSsnitMinor   BigInt  @default(0)
  employerTier2Minor   BigInt  @default(0)

  entity     Entity            @relation(fields: [entityId], references: [id])
  run        PayRun            @relation(fields: [runId], references: [id])
  employee   Employee          @relation(fields: [employeeId], references: [id])
  deductions PayRunDeduction[]

  @@unique([runId, employeeId])
  @@index([entityId, employeeId])
}

/// A loan instalment or other deduction taken on one pay line.
model PayRunDeduction {
  id          String  @id @default(cuid())
  entityId    String
  lineId      String
  loanId      String?
  name        String
  amountMinor BigInt

  entity Entity     @relation(fields: [entityId], references: [id])
  line   PayRunLine @relation(fields: [lineId], references: [id])
  loan   StaffLoan? @relation(fields: [loanId], references: [id])

  @@index([entityId, loanId])
}

enum RemittanceKind {
  PAYE
  SSNIT_TIER_1
  SSNIT_TIER_2
  TIER_3
  NET_PAY
}

/// What a posted pay run left owing, to whom, and by when. Paying it posts
/// the money out of the bank against the liability.
model PayrollRemittance {
  id             String         @id @default(cuid())
  entityId       String
  runId          String
  kind           RemittanceKind
  amountMinor    BigInt
  dueDate        DateTime       @db.Date
  paidOn         DateTime?      @db.Date
  reference      String?
  bankAccountId  String?
  journalEntryId String?        @unique
  paidById       String?
  /// Set when the run is reversed before this was paid: no longer owed.
  cancelledAt    DateTime?

  entity       Entity        @relation(fields: [entityId], references: [id])
  run          PayRun        @relation(fields: [runId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([runId, kind])
  @@index([entityId, dueDate])
}

/// Casual or seasonal labour paid by a buying agent out of their float. Not
/// payroll: it relieves the float like a purchase does, and is a labour cost.
model FloatLabourPayment {
  id             String   @id @default(cuid())
  entityId       String
  floatId        String
  agentId        String
  date           DateTime @db.Date
  description    String
  /// How many people were paid, for the labour report. No names are held.
  workers        Int?
  amountMinor    BigInt
  accountId      String
  journalEntryId String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id])
  float        FloatAdvance  @relation(fields: [floatId], references: [id])
  agent        BuyingAgent   @relation(fields: [agentId], references: [id])
  account      Account       @relation(fields: [accountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([entityId, date])
}

/// Which database this is. One row, set once by `npm run db:mark`.
///
/// It lives in the database rather than in an environment variable so that it
/// cannot be got wrong by pointing a development machine at the wrong
/// connection string: the answer travels with the database being connected to,
/// not with the machine connecting. scripts/db-guard.ts reads it before any
/// migration and refuses to touch a production database from a developer's
/// machine.
model DatabaseMarker {
  id          String   @id @default("singleton")
  /// production | development
  environment String
  /// Something a person recognises, e.g. "Supabase sprouted-prod".
  label       String
  markedAt    DateTime @default(now())
  markedBy    String?
}

// ---------------------------------------------------------------------------
// Pre-finance. Sprouted Crafts borrows to buy raw cashew months before the
// kernel is sold, so the money is out of the door long before it comes back.
// What this section records is that gap: what was borrowed, what was handed to
// aggregators, what came back as nuts, and how long the whole loop took.
//
// Two things are deliberately stored per record rather than as one company
// setting. Quality terms travel with the advance, because they are terms
// agreed with one aggregator on one day, and changing a setting later must not
// re-settle a deal that is already done. Interest terms travel with the
// facility, for the same reason.
//
// The arithmetic — settlement, ageing, interest, cycle margin, recycle, idle
// cost, runway — lives in src/lib/prefinance.ts and is unit-tested without a
// database. Nothing here duplicates it.
// ---------------------------------------------------------------------------

enum LoanFacilityStatus {
  ACTIVE
  CLOSED
}

/// How the year is counted when interest is worked out. Whoever lends says
/// which, and it changes the number, so it is recorded rather than assumed.
enum InterestBasis {
  ACTUAL_365
  ACTUAL_360
  THIRTY_360
}

/// How a wet load is handled. WEIGHT_DEDUCTION pays for the dry-equivalent
/// kilograms at the agreed price; PRICE_DEDUCTION pays for every kilogram
/// delivered, at a price cut per point of moisture above the basis.
enum MoistureMethod {
  WEIGHT_DEDUCTION
  PRICE_DEDUCTION
}

/// How an outturn difference is handled. PROPORTIONAL scales the price with
/// outturn against the basis; PER_POINT takes an agreed amount off the price
/// for each point below it.
enum OutturnMethod {
  PROPORTIONAL
  PER_POINT
}

enum AdvanceStatus {
  OPEN
  SETTLED
  WRITTEN_OFF
}

/// What a new advance is pre-filled with, and when an old one is flagged.
///
/// Defaults only. Every advance keeps its own copy of the quality terms it was
/// agreed on, so changing anything here affects the next advance and never a
/// past one.
model PreFinanceSetting {
  id       String @id @default(cuid())
  entityId String @unique

  /// Kernel outturn the price assumes — pounds of kernel from an 80kg bag.
  defaultOutturn              Decimal        @default(48) @db.Decimal(6, 2)
  /// Moisture percent the price assumes.
  defaultMoisturePct          Decimal        @default(8) @db.Decimal(6, 2)
  defaultMoistureMethod       MoistureMethod @default(WEIGHT_DEDUCTION)
  /// PRICE_DEDUCTION only: percent off the price per point of moisture above basis.
  defaultMoisturePctPerPoint  Decimal?       @db.Decimal(6, 3)
  defaultOutturnMethod        OutturnMethod  @default(PROPORTIONAL)
  /// PER_POINT only: pesewas off the price per point of outturn below basis.
  defaultOutturnMinorPerPoint BigInt?
  /// Whether a load better than the basis earns more. Null follows the method.
  defaultOutturnBonus         Boolean?

  /// Days past the expected delivery date at which an advance is flagged.
  flagAfterDays      Int     @default(14)
  /// Days past expected delivery at which a provision is made against it.
  provisionAfterDays Int     @default(60)
  /// Percent of the advance provided for once it is that old, 0-100.
  provisionPct       Decimal @default(50) @db.Decimal(5, 2)

  updatedAt   DateTime @updatedAt
  updatedById String?

  entity    Entity @relation(fields: [entityId], references: [id])
  updatedBy User?  @relation("PreFinanceSettingUpdatedBy", fields: [updatedById], references: [id])
}

/// A borrowing arrangement: an agreed ceiling drawn down in tranches.
model LoanFacility {
  id         String             @id @default(cuid())
  entityId   String
  /// Whoever is lending, as a contact, so payments hang off the same record.
  lenderId   String?
  reference  String
  limitMinor BigInt
  /// Annual interest rate, e.g. 28.500 for 28.5%.
  ratePct    Decimal            @db.Decimal(6, 3)
  basis      InterestBasis      @default(ACTUAL_365)
  startsOn   DateTime
  /// When the whole facility must be repaid, if it is dated.
  endsOn     DateTime?
  status     LoanFacilityStatus @default(ACTIVE)

  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity    Entity              @relation(fields: [entityId], references: [id])
  lender    Contact?            @relation("FacilityLender", fields: [lenderId], references: [id])
  createdBy User?               @relation("FacilityCreatedBy", fields: [createdById], references: [id])
  tranches  LoanTranche[]
  advances  AggregatorAdvance[]
  cycles    PreFinanceCycle[]

  @@unique([entityId, reference])
  @@index([entityId, status])
}

/// One drawdown against a facility, and its repayment.
model LoanTranche {
  id             String    @id @default(cuid())
  entityId       String
  facilityId     String
  drawnOn        DateTime
  amountMinor    BigInt
  /// Where the money landed. Null for a drawdown from before the cut-over.
  bankAccountId  String?
  /// When the principal was repaid in full. Null while still outstanding.
  repaidOn       DateTime?
  /// How far interest has been posted, so an accrual run knows where it stopped.
  interestToDate DateTime?
  interestMinor  BigInt    @default(0)

  journalEntryId String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id])
  facility     LoanFacility  @relation(fields: [facilityId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User?         @relation("TrancheCreatedBy", fields: [createdById], references: [id])

  @@index([entityId, facilityId])
  @@index([entityId, repaidOn])
}

/// Money handed to an aggregator before any nuts arrive: a receivable with
/// nothing held against it, which is why ageing and exposure limits matter.
///
/// The quality block is a snapshot of what was agreed, copied from
/// PreFinanceSetting when the advance is created and never rewritten.
model AggregatorAdvance {
  id              String   @id @default(cuid())
  entityId        String
  aggregatorId    String
  reference       String
  advancedOn      DateTime
  /// When the nuts were promised. Ageing runs from here, not from the advance.
  expectedOn      DateTime
  amountMinor     BigInt
  /// Where the money went out from.
  bankAccountId   String?
  /// Which facility funded it, when it was funded by borrowing.
  facilityId      String?
  /// The agreed price per kilogram, at the quality basis below.
  pricePerKgMinor BigInt

  outturn              Decimal        @db.Decimal(6, 2)
  moisturePct          Decimal        @db.Decimal(6, 2)
  moistureMethod       MoistureMethod
  moisturePctPerPoint  Decimal?       @db.Decimal(6, 3)
  outturnMethod        OutturnMethod
  outturnMinorPerPoint BigInt?
  outturnBonus         Boolean?

  status    AdvanceStatus @default(OPEN)
  /// Set when the advance closes, whether by delivery, repayment or write-off.
  settledOn DateTime?

  journalEntryId String?  @unique
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entity       Entity            @relation(fields: [entityId], references: [id])
  aggregator   Contact           @relation("AdvanceAggregator", fields: [aggregatorId], references: [id])
  bankAccount  BankAccount?      @relation(fields: [bankAccountId], references: [id])
  facility     LoanFacility?     @relation(fields: [facilityId], references: [id])
  journalEntry JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  createdBy    User?             @relation("AdvanceCreatedBy", fields: [createdById], references: [id])
  deliveries   AdvanceDelivery[]

  @@unique([entityId, reference])
  @@index([entityId, status, expectedOn])
  @@index([entityId, aggregatorId])
}

/// A load delivered against an advance. An advance stays open until enough has
/// been delivered to clear it, so several of these can hang off one advance.
///
/// The settled figures are stored rather than recomputed on the fly: they are
/// what was agreed and posted at the time, and re-deriving them later from
/// terms that may since be read differently would quietly change the books.
model AdvanceDelivery {
  id          String   @id @default(cuid())
  entityId    String
  advanceId   String
  deliveredOn DateTime

  /// What the ticket said, so a dispute can be settled against the paper
  /// rather than against a number somebody re-typed. All optional: a load
  /// weighed on a platform scale has no gross and tare at all.
  vehicle    String?
  waybill    String?
  /// Truck and load together.
  grossGrams BigInt?
  /// Truck alone.
  tareGrams  BigInt?
  bags       Int?
  /// Who released the sample result, when the lab slip is signed.
  assayedBy  String?

  /// Gross less tare where both were given, otherwise weighed directly.
  grams       BigInt
  outturn     Decimal @db.Decimal(6, 2)
  moisturePct Decimal @db.Decimal(6, 2)

  /// Weight actually paid for; differs from grams only under WEIGHT_DEDUCTION.
  adjustedGrams           BigInt
  adjustedPricePerKgMinor BigInt
  /// What the load would have been worth had it met the basis exactly.
  valueAtBasisMinor       BigInt
  settledValueMinor       BigInt
  /// settled minus at-basis. Negative means the load came in under what was agreed.
  varianceMinor           BigInt
  /// The part of the variance caused by water. Never positive.
  moistureVarianceMinor   BigInt
  /// The part caused by outturn. Positive when the load beat the basis.
  outturnVarianceMinor    BigInt

  /// The stock movement this created, so the nuts trace back to the load.
  stockMovementId String?  @unique
  journalEntryId  String?  @unique
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())

  entity        Entity            @relation(fields: [entityId], references: [id])
  advance       AggregatorAdvance @relation(fields: [advanceId], references: [id])
  stockMovement StockMovement?    @relation(fields: [stockMovementId], references: [id])
  journalEntry  JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  createdBy     User?             @relation("DeliveryCreatedBy", fields: [createdById], references: [id])

  @@index([entityId, advanceId])
  @@index([entityId, deliveredOn])
}

/// One loop of the money: drawn, advanced, delivered, processed, sold, paid.
///
/// Held as dates rather than derived, because the question being answered —
/// how many times this money can go round in a season — depends on when cash
/// actually came back, not on when a document happened to be entered.
model PreFinanceCycle {
  id         String  @id @default(cuid())
  entityId   String
  reference  String
  facilityId String?

  drawnOn     DateTime
  advancedOn  DateTime?
  deliveredOn DateTime?
  processedOn DateTime?
  soldOn      DateTime?
  /// When the proceeds actually landed. A cycle is complete only here.
  cashBackOn  DateTime?

  drawnMinor    BigInt
  advancedMinor BigInt @default(0)
  /// Proceeds of the sale this money paid for.
  proceedsMinor BigInt @default(0)
  /// Processing and selling costs attributed to this loop.
  costsMinor    BigInt @default(0)

  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity    Entity        @relation(fields: [entityId], references: [id])
  facility  LoanFacility? @relation(fields: [facilityId], references: [id])
  createdBy User?         @relation("CycleCreatedBy", fields: [createdById], references: [id])

  @@unique([entityId, reference])
  @@index([entityId, cashBackOn])
}
