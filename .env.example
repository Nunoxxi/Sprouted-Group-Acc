# Postgres, via Supabase. Both strings come from
# Supabase -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL: the TRANSACTION pooler (port 6543). Used by the running app.
# DIRECT_URL:   the SESSION pooler (port 5432 on the same pooler host). Used
#               only by `prisma migrate`, which cannot run through the
#               transaction pooler. Do not use the "Direct connection" on
#               db.<ref>.supabase.co — it is IPv6-only on most tiers and fails
#               from Render's build hosts and many home connections.
#
# A local Postgres works identically for development:
#   DATABASE_URL="postgresql://postgres:dev@localhost:5432/sprouted"
#   DIRECT_URL="postgresql://postgres:dev@localhost:5432/sprouted"
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Where ledger export files are written. Defaults to ./exports next to the app.
# Point it at durable storage in production.
EXPORT_DIR=

PORT=3000
