# Postgres, via Supabase. Both strings come from
# Supabase -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL: the TRANSACTION pooler (port 6543). Used by the running app.
# DIRECT_URL:   the SESSION pooler (port 5432 on the same pooler host). Used
#               only by `prisma migrate`, which cannot run through the
#               transaction pooler. Do not use the "Direct connection" on
#               db.<ref>.supabase.co — it is IPv6-only on most tiers and fails
#               from Render's build hosts and many home connections.
#
# A local Postgres works identically for development:
#   DATABASE_URL="postgresql://postgres:dev@localhost:5432/sprouted"
#   DIRECT_URL="postgresql://postgres:dev@localhost:5432/sprouted"
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Where ledger export files are written. Defaults to ./exports next to the app.
# Point it at durable storage in production.
EXPORT_DIR=

PORT=3000

# --- Authentication (Better Auth) --------------------------------------------
# Secret for signing session cookies and encrypting TOTP secrets. Generate one:
#   openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Changing it signs everyone out and invalidates stored TOTP secrets.
BETTER_AUTH_SECRET=
# The public URL of the app; invite and reset links are built from it.
BETTER_AUTH_URL=http://localhost:3000

# Outbound email for invitations and password resets. With RESEND_API_KEY set,
# mail goes through Resend's HTTP API. Without it, in development, the message
# (including the link) is printed to the server console. Production refuses to
# start an invite without a transport.
RESEND_API_KEY=
EMAIL_FROM="Sprouted Accounting <accounting@yourdomain.com>"

# --- File storage (Supabase Storage) ------------------------------------------
# Attachments go in a private bucket here, never in the database. Both come
# from Supabase -> Project Settings -> API. Without them, nothing can be
# attached and the app says so rather than failing quietly.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Personal data encryption -------------------------------------------------
# Telephone numbers, mobile money numbers, addresses, email addresses and the
# signatures farmers give on an agent's phone are encrypted with this key
# before they are stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Keep it out of the database and out of the repository, and keep a copy
# somewhere safe: change it or lose it and every value encrypted under it
# becomes unreadable. The financial records are unaffected either way.
PII_ENCRYPTION_KEY=
